          "id": "chapter-1",
          "number": 1,
          "title": "BUFFALO & HOT SAUCE",
          "recipeCount": 6,
          "recipes": [
            {
              "description": "A bold buffalo ranch chicken sandwich that brings the heat of classic buffalo wings to a fried chicken sandwich. Crispy fried chicken breast is tossed in tangy Frank's RedHot buffalo sauce, then layered with a cool homemade ranch drizzle, buffalo ranch slaw with red onions and celery, a sweet-spicy buffalo bacon jam, and a creamy buffalo ranch cream cheese spread. Finished with candied jalapeños, fried green tomato, and onion rings for the ultimate buffalo experience.",
              "aboutSections": [
                {
                  "name": "Buffalo Sauce",
                  "description": "A classic buffalo wing sauce made by melting butter into Frank's RedHot with a touch of Worcestershire and garlic. Warm, tangy, and perfectly spicy."
                },
                {
                  "name": "Homemade Ranch Dressing",
                  "description": "A from-scratch ranch dressing with fresh herbs — chives, dill, and parsley — blended into a creamy base of mayo, buttermilk, and sour cream. Cool and herbaceous, it balances the buffalo heat."
                },
                {
                  "name": "Buffalo Ranch Slaw",
                  "description": "A crunchy slaw tossed in a buffalo ranch dressing with shredded cabbage, carrots, red onions, and celery. The Frank's RedHot in the dressing ties it back to the buffalo theme."
                },
                {
                  "name": "Buffalo Bacon Jam",
                  "description": "A sweet, smoky, and spicy jam made by rendering bacon with onions and garlic, then simmering in Frank's RedHot and brown sugar. Spread on the bottom bun for a rich, savory base."
                },
                {
                  "name": "Buffalo Ranch Cream Cheese Spread",
                  "description": "A smooth, tangy spread combining softened cream cheese with Frank's RedHot and ranch seasoning. Spread on the bottom bun under the bacon jam for a creamy, spicy foundation."
                }
              ],
              "ingredientGroups": [
                {
                  "name": "Chicken & Batter",
                  "ingredients": [
                    {
                      "item": "boneless, skinless chicken breasts",
                      "amount": "6-8 oz"
