            {
              "usedIn": [
                "Red Wine Onion Gravy Chicken Sandwich"
              ],
              "description": "NOT a traditional slaw—this is a hearty braise of shredded beef with stewed carrots, onions, garlic, celery, fresh rosemary, and thyme. Rich, deep, and complex without any cabbage.",
              "ingredients": [
                {
                  "item": "beef chuck roast, braised and shredded",
                  "amount": "1/3 cup"
                },
                {
                  "item": "carrots, diced and stewed",
                  "amount": "1/3 cup"
                },
                {
                  "item": "onions, diced and stewed",
                  "amount": "1/3 cup"
                },
                {
                  "item": "garlic cloves, minced and stewed",
                  "amount": "3"
                },
                {
                  "item": "celery, diced and stewed",
                  "amount": "1/3 cup"
                },
                {
                  "item": "beef stock",
                  "amount": "1/2 cup"
                },
                {
                  "item": "red wine",
                  "amount": "2 tbsp"
                },
                {
                  "item": "tomato paste",
                  "amount": "1 tsp"
                },
                {
                  "item": "fresh rosemary, minced",
                  "amount": "1 tsp"
                },
                {
                  "item": "fresh thyme, minced",
                  "amount": "1.5 tsp"
                },
                {
                  "item": "Worcestershire sauce",
                  "amount": "1 tsp"
                },
                {
                  "item": "cracked black pepper",
                  "amount": "1/2 tsp"
                },
                {
                  "item": "salt",
                  "amount": "to taste"
                }
              ],
              "directions": [
                "In a large pot, heat 2 tbsp beef tallow or lard over medium-high heat.",
                "Brown the beef chuck (cut into chunks) on all sides, about 8-10 minutes. Remove and set aside.",
                "In the same pot, sauté diced onions, carrots, and celery for 5 minutes until softened.",
                "Add minced garlic and cook for 1 minute.",
                "Return the beef to the pot.",
                "Add red wine, beef stock, tomato paste, fresh rosemary, thyme, and Worcestershire sauce.",
                "Bring to a simmer, then reduce heat to low and cover.",
                "Braise for 2.5-3 hours until beef is very tender and vegetables are fully cooked.",
                "Remove beef from pot and shred using two forks.",
                "Continue simmering vegetables and broth until vegetables are very soft and partially broken down, about 30 more minutes.",
                "Return shredded beef to the pot and stir to combine.",
                "Season with cracked black pepper and salt.",
                "Use immediately or keep warm until ready to assemble sandwich."
              ],
              "id": "comp-red-wine-beef-stew",
              "title": "Red Wine Beef Stew",
              "slug": "red-wine-beef-stew",
              "categoryId": "slaws-salads"
            },
            {
              "usedIn": [
                "Creamed Spinach Chicken Sandwich"
              ],
              "description": "A hearty braised beef with stewed carrots, onions, garlic, and celery—no cream, just rich beef flavor and tender vegetables.",
              "ingredients": [
                {
                  "item": "beef chuck roast, braised and shredded",
                  "amount": "1/3 cup"
                },
                {
                  "item": "carrots, diced and stewed",
                  "amount": "1/3 cup"
                },
                {
                  "item": "onions, diced and stewed",
                  "amount": "1/3 cup"
                },
                {
                  "item": "garlic cloves, minced and stewed",
                  "amount": "3"
                },
                {
                  "item": "celery, diced and stewed",
                  "amount": "1/3 cup"
                },
                {
                  "item": "beef stock",
                  "amount": "1/2 cup"
                },
                {
                  "item": "salt",
                  "amount": "to taste"
                },
                {
                  "item": "black pepper",
                  "amount": "to taste"
                }
              ],
              "directions": [
                "In a large pot, heat 2 tbsp beef tallow or lard over medium-high heat.",
                "Brown the beef chuck (cut into chunks) on all sides, about 8-10 minutes. Remove and set aside.",
                "In the same pot, sauté diced onions, carrots, and celery for 5 minutes until softened.",
                "Add minced garlic and cook for 1 minute.",
                "Return the beef to the pot.",
                "Add beef stock and bring to a simmer.",
                "Reduce heat to low, cover, and braise for 2.5-3 hours until beef is very tender.",
                "Remove beef from pot and shred using two forks.",
                "Continue simmering vegetables in the broth until very soft, about 30 more minutes.",
                "Return shredded beef to the pot and stir to combine.",
                "Season with salt and pepper.",
                "Use immediately or keep warm."
              ],
              "id": "comp-braised-beef-stew",
              "title": "Braised Beef Stew",
              "slug": "braised-beef-stew",
              "categoryId": "slaws-salads"
            },
