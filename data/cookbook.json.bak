              "directionGroups": [
                {
                  "name": "Red Enchilada Sauce",
                  "steps": [
                    "Stem and seed 3-4 dried red chiles (ancho or guajillo).",
                    "Heat a dry skillet over medium heat and toast the chiles for 30 seconds on each side until fragrant.",
                    "Place toasted chiles in a blender with beef broth (1 cup), minced garlic (2 cloves), ground cumin (1/2 teaspoon), dried oregano (1/2 teaspoon), salt, and black pepper.",
                    "Blend until smooth, about 1 minute.",
                    "Strain through a fine-mesh sieve into a saucepan.",
                    "Heat over medium heat and simmer for 5 minutes.",
                    "Stir in Mexican crema (2 tablespoons) and simmer another 2 minutes.",
                    "Season with salt and pepper to taste."
                  ]
                },
                {
                  "name": "Chicken & Batter",
                  "steps": [
                    "Pat chicken breast dry with paper towels.",
                    "Whisk together buttermilk, egg, and fresh lime juice in a shallow bowl.",
                    "In another shallow bowl, combine flour, potato starch, chicken bouillon powder, ground cumin, dried oregano, garlic powder, salt, and black pepper.",
                    "Dip chicken into wet batter, coat thoroughly, then dredge in dry batter, pressing gently to adhere. Let rest on a plate for 5 minutes.",
                    "Heat beef tallow or lard to 350°F in a heavy-bottomed pot or deep skillet, using a thermometer for accuracy.",
                    "Carefully place battered chicken into hot oil and fry for 6-7 minutes until golden brown and internal temperature reaches 165°F.",
                    "Drain on paper towels."
                  ]
                },
                {
                  "name": "Enchilada Cabbage Slaw",
                  "steps": [
                    "In a small bowl, whisk together fresh lime juice, olive oil, apple cider vinegar, chopped cilantro, garlic powder, salt, and black pepper.",
                    "In a medium bowl, toss shredded red cabbage and sliced roasted poblano peppers together.",
                    "Pour the dressing over the slaw and toss to coat.",
                    "Refrigerate until ready to use."
                  ]
                },
                {
                  "name": "Roasted Poblano Peppers",
                  "steps": [
                    "Roast poblano peppers directly over a gas flame or under a broiler until completely charred, about 3-4 minutes per side.",
                    "Place charred peppers in a plastic bag or covered bowl for 5 minutes to steam.",
                    "Peel away the charred skin under cool running water.",
                    "Remove stems and seeds.",
                    "Slice into strips."
                  ]
                },
                {
                  "name": "Cheese and Chorizo Spread",
                  "steps": [
                    "Cook chopped chorizo in a small skillet over medium heat for 3-4 minutes until browned and crumbled.",
                    "Drain excess fat and let cool.",
                    "In a small bowl, combine softened cream cheese and shredded sharp cheddar. Mix until smooth.",
                    "Fold in the cooled crumbled chorizo, garlic powder, and salt until well combined."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter and toast the bun lightly until golden, about 1-2 minutes per side.",
                    "Spread the cheese and chorizo spread on the bottom bun.",
                    "Place the enchilada sauce-coated chicken on top.",
                    "Pile the enchilada cabbage slaw on the chicken.",
                    "Top with roasted poblano strips, crumbled queso fresco, and pickled jalapeños.",
                    "Cap with the toasted top bun.",
                    "Serve immediately while the chicken is hot."
                  ]
                }
              ],
