              "directionGroups": [
                {
                  "name": "Chicken & Batter",
                  "steps": [
                    "Pat chicken breast dry with paper towels.",
                    "Whisk together buttermilk, egg, and fresh lime juice in a shallow bowl.",
                    "In another shallow bowl, combine flour, potato starch, chicken bouillon powder, smoked paprika, chipotle powder, garlic powder, salt, and black pepper.",
                    "Dip chicken into wet batter, coat thoroughly, then dredge in dry batter, pressing gently to adhere. Let rest on a plate for 5 minutes.",
                    "Heat beef tallow or lard to 350°F in a heavy-bottomed pot or deep skillet, using a thermometer for accuracy.",
                    "Carefully place battered chicken into hot oil and fry for 6-7 minutes until golden brown and internal temperature reaches 165°F.",
                    "Drain on paper towels."
                  ]
                },
                {
                  "name": "Chipotle Adobo Crema Sauce",
                  "steps": [
                    "In a blender, combine Mexican crema, chipotle peppers in adobo (2-3 peppers), adobo sauce (1 tablespoon), fresh lime juice, lime zest, minced garlic, and chopped cilantro.",
                    "Blend until smooth and creamy, about 30-45 seconds.",
                    "Season with salt to taste."
                  ]
                },
                {
                  "name": "Smoky Chipotle Cabbage Slaw",
                  "steps": [
                    "In a small bowl, whisk together Mexican crema or mayo, minced chipotle pepper, adobo sauce, apple cider vinegar, fresh lime juice, smoked paprika, salt, and black pepper.",
                    "In a medium bowl, toss shredded red cabbage and shredded carrots together.",
                    "Pour the dressing over the slaw and toss to coat.",
                    "Refrigerate until ready to use."
                  ]
                },
                {
                  "name": "Smoky Bacon Goat Cheese Spread",
                  "steps": [
                    "Cook diced bacon in a skillet over medium heat until crispy, about 6-8 minutes.",
                    "Drain on paper towels and let cool.",
                    "In a small bowl, combine softened cream cheese and fresh goat cheese. Mix until smooth.",
                    "Fold in the cooled crumbled bacon, smoked paprika, garlic powder, and salt until well combined."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter and toast the bun lightly until golden, about 1-2 minutes per side.",
                    "Spread the smoky bacon goat cheese spread on the bottom bun.",
                    "Place the chipotle adobo crema-coated chicken on top.",
                    "Pile the smoky chipotle cabbage slaw on the chicken.",
                    "Top with pickled jalapeños, crumbled cotija cheese, and sliced avocado.",
                    "Cap with the toasted top bun.",
                    "Serve immediately while the chicken is hot."
                  ]
                }
              ],
