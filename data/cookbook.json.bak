                  "name": "Mango Habanero Bacon Jam",
                  "description": "A sweet-fiery jam of crispy bacon, fresh mango, habanero heat, and allspice—balanced with brown sugar and vinegar."
                },
                {
                  "name": "Jerk-Spiced Goat Cheese Spread",
                  "description": "A creamy spread blending goat cheese with cream cheese, jerk seasoning, and lime for savory island flavor."
                },
                {
                  "name": "Candied Jalapeños",
                  "description": "A key component that complements the chicken and sauce."
                }
              ],
