            {
              "usedIn": [
                "Buffalo Ranch Chicken Sandwich",
                "Buffalo Blue Cheese Chicken Sandwich"
              ],
              "description": "A classic buffalo wing sauce made by melting butter into Frank's RedHot with a touch of Worcestershire and garlic. Warm, tangy, and perfectly spicy.",
              "ingredients": [
                {
                  "item": "Frank's RedHot sauce",
                  "amount": "1/3 cup"
                },
                {
                  "item": "unsalted butter",
                  "amount": "2 tablespoons"
                },
                {
                  "item": "Worcestershire sauce",
                  "amount": "1/2 teaspoon"
                },
                {
                  "item": "garlic powder",
                  "amount": "1/4 teaspoon"
                }
              ],
              "directions": [
                "In a small saucepan over medium-low heat, melt the butter.",
                "Add Frank's RedHot sauce, Worcestershire sauce, and garlic powder.",
                "Whisk until combined and warmed through, about 2 minutes.",
                "Remove from heat. Toss the fried chicken in the sauce to coat."
              ],
              "id": "comp-buffalo-sauce",
              "title": "Buffalo Sauce",
              "slug": "buffalo-sauce",
              "categoryId": "sauces-glazes-aiolis"
            },
            {
              "usedIn": [
                "Buffalo Ranch Chicken Sandwich"
              ],
              "description": "A from-scratch ranch dressing with fresh herbs — chives, dill, and parsley — blended into a creamy base of mayo, buttermilk, and sour cream. Cool and herbaceous, it balances the buffalo heat.",
              "ingredients": [
                {
                  "item": "mayonnaise",
                  "amount": "1/3 cup"
                },
                {
                  "item": "buttermilk",
                  "amount": "2 tablespoons"
                },
                {
                  "item": "sour cream",
                  "amount": "2 tablespoons"
                },
                {
                  "item": "fresh chives, minced",
                  "amount": "1 tablespoon"
                },
                {
                  "item": "fresh dill, minced",
                  "amount": "1 tablespoon"
                },
                {
                  "item": "fresh parsley, minced",
                  "amount": "1/2 tablespoon"
                },
                {
                  "item": "garlic, minced",
                  "amount": "1/2 teaspoon"
                },
                {
                  "item": "fresh lemon juice",
                  "amount": "1 teaspoon"
                },
                {
                  "item": "salt",
                  "amount": "1/4 teaspoon"
                },
                {
                  "item": "black pepper",
                  "amount": "1/8 teaspoon"
                }
              ],
              "directions": [
                "In a small bowl, whisk together mayonnaise, buttermilk, and sour cream until smooth.",
                "Stir in chives, dill, parsley, minced garlic, and lemon juice.",
                "Season with salt and pepper. Refrigerate until ready to use."
              ],
              "id": "comp-homemade-ranch-dressing",
              "title": "Homemade Ranch Dressing",
              "slug": "homemade-ranch-dressing",
              "categoryId": "sauces-glazes-aiolis"
            },
            {
              "usedIn": [
                "Buffalo Blue Cheese Chicken Sandwich"
              ],
              "description": "A creamy dressing with large chunks of Gorgonzola or Roquefort cheese stirred into a base of mayo and sour cream, balanced with lemon juice and Worcestershire for a sophisticated, tangy bite.",
              "ingredients": [
                {
                  "item": "mayonnaise",
                  "amount": "1/3 cup"
                },
                {
                  "item": "sour cream",
                  "amount": "2 tablespoons"
                },
                {
                  "item": "crumbled Gorgonzola or Roquefort cheese",
                  "amount": "3 ounces"
                },
                {
                  "item": "fresh lemon juice",
                  "amount": "1 teaspoon"
                },
                {
                  "item": "Worcestershire sauce",
                  "amount": "1/4 teaspoon"
                },
                {
                  "item": "garlic powder",
                  "amount": "1/4 teaspoon"
                },
                {
                  "item": "salt",
                  "amount": "1/8 teaspoon"
                },
                {
                  "item": "black pepper",
                  "amount": "1/8 teaspoon"
                }
              ],
              "directions": [
                "In a small bowl, whisk together mayonnaise and sour cream until smooth.",
                "Stir in crumbled Gorgonzola or Roquefort cheese, breaking it into large chunks.",
                "Add fresh lemon juice, Worcestershire sauce, and garlic powder.",
                "Season with salt and pepper. Refrigerate until ready to use."
              ],
              "id": "comp-chunky-blue-cheese-dressing",
              "title": "Chunky Blue Cheese Dressing",
              "slug": "chunky-blue-cheese-dressing",
              "categoryId": "sauces-glazes-aiolis"
            },
            {
              "usedIn": [
                "Sunkist Buffalo Chicken Sandwich"
              ],
              "description": "A unique blend of reduced Sunkist orange soda combined with Frank's RedHot and butter. The citrus sweetness balances the heat, creating a tangy-spicy sauce with fruity notes.",
              "ingredients": [
                {
                  "item": "Sunkist orange soda",
                  "amount": "1 1/2 cups"
                },
                {
                  "item": "Frank's RedHot sauce",
                  "amount": "1/2 cup"
                },
                {
                  "item": "packed brown sugar",
                  "amount": "1/4 cup"
                },
                {
                  "item": "unsalted butter",
                  "amount": "1/4 cup"
                },
                {
                  "item": "garlic cloves, minced",
                  "amount": "3"
                },
                {
                  "item": "orange zest",
                  "amount": "1 tablespoon"
                },
                {
                  "item": "crushed red pepper flakes",
                  "amount": "1 teaspoon"
                },
                {
                  "item": "salt",
                  "amount": "1/4 teaspoon"
                }
              ],
              "directions": [
                "Pour 1 cup of Sunkist orange soda into a small saucepan over medium-high heat.",
                "Bring to a simmer and reduce until syrupy and about 1/4 cup remains, about 10-12 minutes.",
                "Reduce heat to low and whisk in Frank's RedHot sauce and butter.",
                "Stir until combined and warmed through, about 2 minutes.",
                "Remove from heat. Toss the fried chicken in the sauce to coat."
              ],
              "id": "comp-sunkist-buffalo-sauce",
              "title": "Sunkist Buffalo Sauce",
              "slug": "sunkist-buffalo-sauce",
              "categoryId": "sauces-glazes-aiolis"
            },
            {
              "usedIn": [
                "Brown Sugar Frank's Hot Chicken Sandwich"
              ],
              "description": "A glossy glaze made by simmering Frank's RedHot with brown sugar, butter, and garlic. The sugar caramelizes slightly, creating a sweet-spicy coating with subtle molasses notes.",
              "ingredients": [
                {
                  "item": "Frank's RedHot sauce",
                  "amount": "1/3 cup"
                },
                {
                  "item": "packed brown sugar",
                  "amount": "2 tablespoons"
                },
                {
                  "item": "unsalted butter",
                  "amount": "2 tablespoons"
                },
                {
                  "item": "garlic powder",
                  "amount": "1/4 teaspoon"
                }
              ],
              "directions": [
                "In a small saucepan over medium heat, combine Frank's RedHot sauce, brown sugar, and butter.",
                "Stir constantly until the brown sugar dissolves and the sauce is smooth, about 2-3 minutes.",
                "Add minced garlic and stir until combined.",
                "Reduce heat to low and keep warm until ready to coat the chicken."
              ],
              "id": "comp-brown-sugar-franks-glaze",
              "title": "Brown Sugar Frank's Glaze",
              "slug": "brown-sugar-franks-glaze",
              "categoryId": "sauces-glazes-aiolis"
            },
            {
              "usedIn": [
                "Smokey Dr Pepper BBQ Chicken Sandwich"
              ],
              "description": "A unique BBQ sauce made by reducing Dr Pepper with tomato sauce, brown sugar, and liquid smoke. The result is a thick, sweet-and-smoky glaze with a subtle cherry caramel notes from the soda.",
              "ingredients": [
                {
                  "item": "Dr Pepper (regular, not diet)",
                  "amount": "1 can (12 oz)"
                },
                {
                  "item": "Tomato sauce",
                  "amount": "1 cup"
                },
                {
                  "item": "Packed brown sugar",
                  "amount": "1/4 cup"
                },
                {
                  "item": "Apple cider vinegar",
                  "amount": "2 tablespoons"
                },
                {
                  "item": "Worcestershire sauce",
                  "amount": "1 tablespoon"
                },
                {
                  "item": "Liquid smoke (hickory)",
                  "amount": "1/2 teaspoon"
                },
                {
                  "item": "Smoked paprika",
                  "amount": "1 teaspoon"
                },
                {
                  "item": "Garlic powder",
                  "amount": "1/2 teaspoon"
                },
                {
                  "item": "Onion powder",
                  "amount": "1/2 teaspoon"
                },
                {
                  "item": "Black pepper",
                  "amount": "1/4 teaspoon"
                },
                {
                  "item": "Salt",
                  "amount": "to taste"
                }
              ],
              "directions": [
                "In a medium saucepan, combine Dr Pepper, tomato sauce, and brown sugar.",
                "Add apple cider vinegar, Worcestershire sauce, liquid smoke, smoked paprika, garlic powder, and onion powder.",
                "Bring to a boil over medium-high heat, then reduce heat to low.",
                "Simmer for 15-20 minutes, stirring occasionally, until the sauce thickens and reduces by about one-third.",
                "Season with salt and black pepper to taste.",
                "Remove from heat and let cool slightly. Toss the fried chicken in the sauce to coat."
              ],
              "id": "comp-smokey-dr-pepper-bbq-sauce",
              "title": "Smokey Dr Pepper BBQ Sauce",
              "slug": "smokey-dr-pepper-bbq-sauce",
              "categoryId": "sauces-glazes-aiolis"
            },
