              "directionGroups": [
                {
                  "name": "Chicken & Batter",
                  "steps": [
                    "Pat chicken breast dry with paper towels.",
                    "Whisk together buttermilk, egg, and fresh lime juice in a shallow bowl.",
                    "In another shallow bowl, combine flour, potato starch, chicken bouillon powder, garlic powder, ground cumin (1/4 teaspoon), paprika (1/4 teaspoon), salt, and black pepper.",
                    "Dip chicken into wet batter, coat thoroughly, then dredge in dry batter, pressing gently to adhere. Let rest on a plate for 5 minutes.",
                    "Heat beef tallow or lard to 350°F in a heavy-bottomed pot or deep skillet, using a thermometer for accuracy.",
                    "Carefully place battered chicken into hot oil and fry for 6-7 minutes until golden brown and internal temperature reaches 165°F.",
                    "Drain on paper towels."
                  ]
                },
                {
                  "name": "Sofrito Sauce",
                  "steps": [
                    "Heat olive oil (1 tablespoon) in a saucepan over medium heat.",
                    "Sauté diced yellow onion (2 tablespoons), minced garlic (2 cloves), and diced bell pepper (red and yellow, 1/4 cup total) for 3-4 minutes until softened.",
                    "Add diced tomato (2 tablespoons) and chopped cilantro (2 tablespoons).",
                    "Cook for 2 minutes, stirring frequently.",
                    "Add Mexican crema or mayonnaise (1/4 cup) and gently warm through.",
                    "Season with salt, white pepper, and a pinch of ground cumin.",
                    "The sauce should be chunky yet pourable."
                  ]
                },
                {
                  "name": "Puerto Rican Cabbage Slaw",
                  "steps": [
                    "In a small bowl, whisk together fresh lime juice (1 tablespoon), olive oil (2 teaspoons), apple cider vinegar (1 teaspoon), chopped cilantro (1 tablespoon), salt, and black pepper.",
                    "In a medium bowl, toss shredded red cabbage (1/4 cup), diced pimientos (2 tablespoons), and pickled red onions (2 tablespoons) together.",
                    "Pour the dressing over the slaw and toss to coat.",
                    "Refrigerate until ready to use."
                  ]
                },
                {
                  "name": "Chorizo and Cheddar Spread",
                  "steps": [
                    "Cook finely chopped chorizo (2 tablespoons) in a small skillet over medium heat for 2-3 minutes until browned and crumbled.",
                    "Drain excess fat and let cool.",
                    "In a small bowl, combine softened cream cheese (1 tablespoon) and shredded sharp cheddar (1 tablespoon). Mix until smooth.",
                    "Fold in the cooled crumbled chorizo, garlic powder, and salt until well combined."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter and toast the bun lightly until golden, about 1-2 minutes per side.",
                    "Spread the chorizo and cheddar spread on the bottom bun.",
                    "Place the sofrito sauce-coated chicken on top.",
                    "Pile the Puerto Rican cabbage slaw on the chicken.",
                    "Top with pickled peppers, pimientos, crumbled queso fresco, and sliced avocado.",
                    "Cap with the toasted top bun.",
                    "Serve immediately while the chicken is hot."
                  ]
                }
              ],
