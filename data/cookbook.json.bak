            {
              "usedIn": [
                "Creamed Spinach Chicken Sandwich"
              ],
              "description": "A generous, luxurious portion of fresh spinach sautéed in butter and garlic, then enriched with cream cheese, heavy cream, and Parmesan cheese with just a whisper of nutmeg. This is the star component.",
              "ingredients": [
                {
                  "item": "fresh spinach, packed",
                  "amount": "4 cups"
                },
                {
                  "item": "unsalted butter",
                  "amount": "4 tbsp"
                },
                {
                  "item": "garlic cloves, minced",
                  "amount": "3"
                },
                {
                  "item": "cream cheese",
                  "amount": "4 tbsp"
                },
                {
                  "item": "heavy cream",
                  "amount": "4 tbsp"
                },
                {
                  "item": "Parmesan cheese, grated",
                  "amount": "4 tbsp"
                },
                {
                  "item": "nutmeg",
                  "amount": "1/8 tsp"
                },
                {
                  "item": "salt",
                  "amount": "to taste"
                },
                {
                  "item": "black pepper",
                  "amount": "to taste"
                }
              ],
              "directions": [
                "In a large skillet over medium-high heat, melt 4 tbsp butter.",
                "Add minced garlic and cook for 30 seconds until fragrant.",
                "Add packed fresh spinach in batches, stirring until wilted. This may take 5-7 minutes as the spinach releases water.",
                "Once all spinach is wilted, reduce heat to medium-low.",
                "Cut cream cheese into small cubes and add to the spinach, stirring until melted and combined.",
                "Add heavy cream slowly while stirring, incorporating it fully.",
                "Fold in grated Parmesan cheese and stir until melted and smooth.",
                "Season with a whisper of nutmeg, salt, and black pepper.",
                "Keep warm on low heat until ready to serve. Stir occasionally."
              ],
              "id": "comp-creamed-spinach",
              "title": "Creamed Spinach",
              "slug": "creamed-spinach",
              "categoryId": "cheese-spreads"
            },
