              "ingredients": [
                {
                  "item": "thick-cut bacon (diced)",
                  "amount": "4 slices"
                },
                {
                  "item": "shallots (minced)",
                  "amount": "1 shallot"
                },
                {
                  "item": "green peppercorns in brine (drained, crushed)",
                  "amount": "1 tbsp"
                },
                {
                  "item": "brandy or cognac",
                  "amount": "1 tbsp"
                },
                {
                  "item": "Dijon mustard",
                  "amount": "1/2 tsp"
                },
                {
                  "item": "brown sugar",
                  "amount": "1 tbsp"
                },
                {
                  "item": "apple cider vinegar",
                  "amount": "1 tbsp"
