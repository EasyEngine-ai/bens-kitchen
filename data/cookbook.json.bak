              "directionGroups": [
                {
                  "name": "Chicken & Batter",
                  "steps": [
                    "Pound the chicken breast to an even 3/4-inch thickness.",
                    "In a shallow bowl, whisk together buttermilk and egg.",
                    "In another shallow bowl, combine all-purpose flour, potato starch, chicken bouillon powder, paprika, garlic powder, onion powder, salt, and black pepper.",
                    "Submerge the chicken in the wet batter for at least 15 minutes (or up to 4 hours in the fridge).",
                    "Heat beef tallow or lard to 350°F in a deep pot or cast iron skillet.",
                    "Remove chicken from wet batter, letting excess drip off. Dredge thoroughly in the dry batter, pressing to adhere. For extra crunch, dip back in wet batter and dredge again.",
                    "Fry for 6-8 minutes, flipping halfway, until golden brown and internal temperature reaches 165°F.",
                    "Rest on a wire rack for 2 minutes."
                  ]
                },
                {
                  "name": "Carolina Gold Mustard BBQ Sauce",
                  "steps": [
                    "In a small saucepan, combine yellow mustard, apple cider vinegar, and brown sugar.",
                    "Add garlic powder, onion powder, Worcestershire sauce, paprika, and cayenne pepper.",
                    "Whisk until combined over medium heat.",
                    "Warm through for 2-3 minutes, stirring occasionally.",
                    "Season with salt and black pepper to taste.",
                    "Remove from heat. Toss the fried chicken in the sauce to coat."
                  ]
                },
                {
                  "name": "Carolina Slaw",
                  "steps": [
                    "In a large bowl, combine shredded cabbage and carrots.",
                    "In a small bowl, whisk together apple cider vinegar, yellow mustard, sugar, and salt.",
                    "Pour the dressing over the vegetables and toss to coat evenly.",
                    "Season with black pepper. Refrigerate for at least 15 minutes before serving."
                  ]
                },
                {
                  "name": "Carolina Bacon Jam",
                  "steps": [
                    "In a skillet over medium heat, cook the diced bacon until crispy, about 6-8 minutes.",
                    "Remove half the bacon fat, leaving about 1 tablespoon in the pan.",
                    "Add diced onion and cook until softened and golden, about 5-7 minutes.",
                    "Add minced garlic and cook for 1 minute until fragrant.",
                    "Stir in brown sugar and apple cider vinegar.",
                    "Reduce heat to low and simmer for 8-10 minutes, stirring occasionally, until thick and jammy.",
                    "Season with salt. Let cool slightly—it will thicken as it cools."
                  ]
                },
                {
                  "name": "Carolina Cheese Spread",
                  "steps": [
                    "In a small bowl, combine softened sharp cheddar with 2 tablespoons of the cooled mustard BBQ sauce.",
                    "Mix until smooth and well blended.",
                    "Spread on the bottom bun before assembling."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter both halves of the bun and toast on a griddle or skillet until golden, about 2 minutes.",
                    "Spread Carolina Cheese Spread on the bottom bun.",
                    "Spoon a generous layer of Carolina Bacon Jam on top of the spread.",
                    "Place the mustard-coated chicken on top.",
                    "Pile on Carolina Slaw.",
                    "Add fresh tomato slices.",
                    "Place the top bun and serve immediately."
                  ]
                }
              ],
              "id": "recipe-8",
              "number": 8,
              "title": "Carolina Gold Chicken Sandwich",
              "slug": "carolina-gold-chicken-sandwich",
              "chapterId": "chapter-2"
            },
            {
              "description": "An elevated take on BBQ chicken that combines sweet maple syrup, bourbon, and smoky bacon with a rich maple-bourbon glaze. Topped with candied bacon strips, crispy fried egg for richness and creaminess, plus aged Gruyère for a sophisticated yet indulgent sandwich that's pure elevated comfort food.",
              "aboutSections": [
                {
                  "name": "Maple Bourbon BBQ Sauce",
                  "description": "A sophisticated glaze made by reducing maple syrup with bourbon, brown sugar, and BBQ sauce. The result is a rich, complex sauce with deep caramel notes and a subtle whiskey warmth."
                },
                {
                  "name": "Candied Bacon",
                  "description": "Thick-cut bacon coated with maple syrup and brown sugar, then baked until crispy and candied. Sweet, smoky, and irresistibly crunchy."
                },
                {
                  "name": "Maple Bourbon Slaw",
                  "description": "A crisp slaw dressed with a maple vinaigrette, providing bright acidity that complements the rich sauce."
                },
                {
                  "name": "Aged Cheddar Spread",
                  "description": "Creamy aged cheddar blended with a touch of the maple bourbon sauce for a smooth, nutty spread with excellent depth."
                }
              ],
