          "title": "ITALIAN",
          "recipeCount": 9,
          "recipes": [
            {
              "description": "Inspired by the viral chopped Italian sandwich, this fried chicken version takes the classic deli sub to the next level. The crispy chicken is dunked in a spicy Italian oil-vinegar sauce loaded with pepperoncini and Italian seasoning, then topped with a chopped Italian salad of salami, provolone, lettuce, tomatoes, red onions, and banana peppers. A pepperoni cherry tomato jam on the bottom sub roll adds a sweet-savory Italian depth that ties the whole thing together.",
              "aboutSections": [
                {
                  "name": "Chicken & Batter",
                  "description": "A seasoned, double-breaded fried chicken cutlet with Italian herbs, oregano, and basil for a true Italian flavor profile."
                },
                {
                  "name": "Italian Oil-Vinegar Pepperoncini Sauce",
                  "description": "A bright, tangy sauce combining mayo, olive oil, and red wine vinegar, spiked with minced pepperoncini peppers and their brine for a spicy kick."
                },
                {
                  "name": "Italian Arugula Slaw",
                  "description": "A fresh, peppery slaw of baby arugula, shredded red cabbage, cherry tomatoes, feta cheese, and salami, dressed with a light red wine vinegar vinaigrette."
                },
                {
                  "name": "Pepperoni Cherry Tomato Jam",
                  "description": "A sweet and savory jam made from pepperoni, fresh and sun-dried cherry tomatoes, caramelized onions, and garlic, reduced to a thick, spreadable consistency."
                },
                {
                  "name": "Marinara Basil Goat Feta Roasted Pepper Spread",
                  "description": "A tangy, herby spread combining fresh goat cheese and cream cheese with marinara sauce, Parmesan, fresh basil, roasted red peppers, roasted garlic, and crumbled feta."
                }
              ],
              "ingredientGroups": [
                {
