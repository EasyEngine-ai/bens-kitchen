                      "item": "brown sugar",
                      "amount": "1 tablespoon"
                    },
                    {
                      "item": "red wine vinegar",
                      "amount": "1 teaspoon"
                    },
                    {
                      "item": "Italian seasoning",
                      "amount": "1/2 teaspoon"
                    },
                    {
                      "item": "red pepper flakes",
                      "amount": "1/4 teaspoon"
                    },
                    {
                      "item": "salt",
                      "amount": "to taste"
                    }
                  ]
                },
                {
                  "name": "Toppings & Assembly",
                  "ingredients": [
                    {
                      "item": "1 Italian sub roll, split",
                      "amount": ""
                    },
                    {
                      "item": "1 tablespoon unsalted butter, softened",
                      "amount": ""
                    },
                    {
                      "item": "Italian Arugula Slaw",
                      "amount": ""
                    },
                    {
                      "item": "Pepperoni Cherry Tomato Jam",
                      "amount": ""
                    },
                    {
                      "item": "Whipped Goat Cheese Spread",
                      "amount": ""
                    },
                    {
                      "item": "Caramelized Onions",
                      "amount": ""
                    },
                    {
                      "item": "Fresh baby arugula (1/2 cup)",
                      "amount": ""
                    },
                    {
                      "item": "Roasted red peppers (2-3 large strips)",
                      "amount": ""
                    },
                    {
                      "item": "Balsamic Glaze (for drizzling)",
                      "amount": ""
                    }
                  ]
                }
              ],
              "directionGroups": [
                {
                  "name": "Balsamic Glaze",
                  "steps": [
                    "In a small saucepan, combine balsamic vinegar and brown sugar over medium heat.",
                    "Bring to a simmer and cook for 12-15 minutes, stirring occasionally, until reduced by half.",
                    "The glaze should be thick and syrupy.",
                    "Remove from heat and let cool. It will thicken further as it cools."
                  ]
                },
                {
                  "name": "Caramelized Onions",
                  "steps": [
                    "Slice 1/2 medium yellow onion into thin rings.",
                    "In a small skillet over medium-low heat, melt butter.",
                    "Add onion rings, salt, and black pepper.",
                    "Cook for 12-15 minutes, stirring occasionally, until deeply golden and caramelized.",
                    "Set aside until ready to use."
                  ]
                },
                {
                  "name": "Whipped Goat Cheese Spread",
                  "steps": [
                    "In a small bowl, combine fresh goat cheese and softened cream cheese.",
                    "Using a fork or small whisk, whip together until smooth and fluffy.",
                    "Fold in crumbled feta cheese, mashed roasted garlic, diced roasted red peppers, and minced fresh thyme.",
                    "Season with salt and white pepper. Set aside."
                  ]
                },
                {
                  "name": "Pepperoni Cherry Tomato Jam",
                  "steps": [
                    "In a small skillet over medium heat, cook diced pepperoni for 2-3 minutes until it renders fat and begins to crisp.",
                    "Add finely diced onion and minced garlic, cooking for 2 minutes until softened.",
                    "Add quartered cherry tomatoes, chopped sun-dried tomatoes, brown sugar, Italian seasoning, and red pepper flakes.",
                    "Reduce heat to medium-low and simmer for 10-12 minutes, stirring occasionally, until tomatoes break down and mixture becomes thick and jammy.",
                    "Season with salt. Remove from heat and cool slightly."
                  ]
                },
                {
                  "name": "Italian Arugula Slaw",
                  "steps": [
                    "In a large bowl, combine baby arugula, shredded red cabbage, halved cherry tomatoes, sliced red onions, and crumbled feta cheese.",
                    "Add sliced pepperoncini peppers, sliced cherry peppers, chopped salami, and crushed croutons.",
                    "In a small bowl, whisk together mayonnaise, red wine vinegar, extra virgin olive oil, and Italian seasoning.",
                    "Pour dressing over vegetables and toss to coat evenly.",
                    "Season with salt and black pepper. Refrigerate until ready to serve."
                  ]
                },
                {
                  "name": "Chicken & Batter",
                  "steps": [
                    "Pound the chicken cutlet to an even 3/4-inch thickness.",
                    "In a shallow bowl, whisk together buttermilk and egg.",
                    "In another shallow bowl, combine all-purpose flour, potato starch, chicken bouillon powder, dried thyme, garlic powder, salt, and black pepper.",
                    "Submerge chicken in wet batter for at least 15 minutes (or up to 4 hours refrigerated).",
                    "Remove from wet batter and dredge thoroughly in dry batter, pressing gently to adhere. For extra crunch, dip back in wet batter and dredge again.",
                    "Heat beef tallow or lard to 350°F in a deep pot or cast iron skillet.",
                    "Carefully place breaded chicken into hot oil and fry for 6-7 minutes until golden brown and internal temperature reaches 165°F.",
                    "Remove with slotted spoon and drain on a wire rack."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter both halves of the sub roll and toast on a griddle or skillet for 1-2 minutes until golden.",
                    "Spread Whipped Goat Cheese Spread on the bottom sub roll.",
                    "Spoon a generous layer of Pepperoni Cherry Tomato Jam over the spread.",
                    "Place the fried chicken on top of the jam.",
                    "Layer roasted red pepper strips over the chicken.",
                    "Top with caramelized onions.",
                    "Pile fresh baby arugula and Italian Arugula Slaw on top.",
                    "Drizzle balsamic glaze over the arugula and red peppers.",
                    "Place top bun and serve immediately while hot."
                  ]
                }
              ],
              "id": "recipe-36",
              "number": 36,
              "title": "Balsamic Glaze Chicken Sub",
              "slug": "balsamic-glaze-chicken-sub",
              "chapterId": "chapter-5"
            },
            {
              "description": "A refined take on the Caesar salad, this sub features a Parmesan-heavy homemade Caesar dressing loaded with lemon and anchovy, draped over crispy fried chicken. Crisp romaine hearts, fine crouton crumbles, and shaved Parmigiano-Reggiano pile on top, while a roasted garlic feta cream cheese spread on the bottom sub roll adds tangy, creamy depth to every bite.",
              "aboutSections": [
                {
                  "name": "Chicken & Batter",
                  "description": "A perfectly golden fried chicken cutlet with a delicate crust seasoned with garlic and dried parsley."
                },
                {
                  "name": "Parmesan-Heavy Caesar Dressing",
                  "description": "A rich, tangy dressing made with pasteurized egg yolk, anchovy paste, fresh lemon juice, Dijon mustard, and a generous amount of grated Parmesan."
                },
                {
                  "name": "Roasted Garlic Feta Cream Cheese Spread",
                  "description": "A tangy, creamy spread combining cream cheese and goat cheese with roasted garlic, feta cheese, and roasted red peppers."
                },
                {
                  "name": "Italian Arugula Slaw",
                  "description": "A fresh, peppery slaw of baby arugula, shredded red cabbage, cherry tomatoes, feta cheese, and salami, dressed with a light red wine vinegar vinaigrette."
                },
                {
                  "name": "Pepperoni Cherry Tomato Jam",
                  "description": "A sweet and savory jam made from pepperoni, fresh and sun-dried cherry tomatoes, caramelized onions, and garlic, reduced to a thick, spreadable consistency."
                }
              ],
