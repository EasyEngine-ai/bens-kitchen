                  "item": "fresh lemon juice",
                  "amount": "1.5 tsp"
                },
                {
                  "item": "red wine vinegar",
                  "amount": "1.5 tsp"
                },
                {
                  "item": "unsalted butter, melted",
                  "amount": "1.5 tbsp"
                },
                {
                  "item": "coarse black pepper",
                  "amount": "1.5 tsp"
                },
                {
                  "item": "salt",
                  "amount": "to taste"
                },
                {
                  "item": "fresh dill, minced (optional)",
                  "amount": "1.5 tsp"
                }
              ],
              "directions": [
