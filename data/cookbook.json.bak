              ],
              "description": "A tart-sweet compote made with fresh cranberries, orange juice, cinnamon, nutmeg, and ginger for warm holiday flavor.",
              "ingredients": [
                {
                  "item": "fresh cranberries",
                  "amount": "1 cup"
                },
