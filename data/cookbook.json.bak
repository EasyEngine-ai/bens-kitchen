              "directionGroups": [
                {
                  "name": "Chicken & Batter",
                  "steps": [
                    "Combine 1/2 cup buttermilk and 1 egg in a bowl and whisk until smooth. Set aside wet batter.",
                    "In another bowl, whisk together 1/4 cup all-purpose flour, 1/4 cup potato starch, 1 tsp chicken bouillon powder, 1/2 tsp lemon zest, 1/2 tsp salt, and 1/4 tsp white pepper. Set aside dry batter.",
                    "Pat 6-8 oz chicken breasts dry with paper towels.",
                    "Dip chicken into wet batter, coating completely, then dredge in dry batter, shaking off excess.",
                    "Heat 2 cups beef tallow or lard to 350°F in a heavy-bottomed pot or Dutch oven.",
                    "Carefully place breaded chicken into hot fat and fry for 8-10 minutes until golden brown and internal temperature reaches 165°F.",
                    "Remove chicken and drain on paper towels."
                  ]
                },
                {
                  "name": "Lemon Butter Cream Sauce",
                  "steps": [
                    "Heat 3 tbsp unsalted butter in a saucepan over medium-low heat.",
                    "Add 2 minced garlic cloves, cook 1 minute.",
                    "Pour in 2 tbsp fresh lemon juice and 1/2 tsp lemon zest, simmer 1 minute.",
                    "Add 1/2 cup heavy cream and 2 tbsp chicken broth, bring to gentle simmer.",
                    "Cook 2 minutes.",
                    "Remove from heat and stir in 1 tbsp fresh dill (minced) and 1 tbsp fresh parsley (minced).",
                    "Season with 1/4 tsp salt and 1/8 tsp white pepper.",
                    "Keep warm and reserve 2 tbsp for slaw dressing."
                  ]
                },
                {
                  "name": "Sautéed Fresh Spinach",
                  "steps": [
                    "Heat 1 tbsp unsalted butter in a skillet over medium heat.",
                    "Add 1 minced garlic clove, cook 30 seconds.",
                    "Add 2 cups packed fresh spinach and cook 2-3 minutes until wilted and moisture evaporated.",
                    "Season with 1/8 tsp salt and a pinch of white pepper.",
                    "Set aside."
                  ]
                },
                {
                  "name": "Lemon Herb Romaine Slaw",
                  "steps": [
                    "Whisk together 2 tbsp lemon butter cream sauce, 1 tbsp mayonnaise, 1 tbsp fresh lemon juice, 1/2 tsp Dijon mustard, and a pinch of salt for the dressing.",
                    "In a bowl, combine 1/2 cup shredded romaine lettuce, 1/4 cup fresh baby spinach (shredded), 1 tbsp shaved Parmesan, 1 tsp fresh dill (chopped), 1 tbsp fresh parsley (chopped), and 1/4 tsp lemon zest.",
                    "Pour dressing over and toss to coat.",
                    "Refrigerate until ready to serve."
                  ]
                },
                {
                  "name": "Lemon Herb Bacon Jam",
                  "steps": [
                    "Cook 4 slices diced thick-cut bacon in a skillet over medium heat until crispy, about 6-7 minutes.",
                    "Drain most fat, leaving about 1 tbsp in the pan.",
                    "Add 1 minced shallot, cook 2 minutes.",
                    "Add 1 tbsp fresh lemon juice, 1/4 tsp lemon zest, and 1/2 tsp fresh dill (minced), cook 1 minute.",
                    "Add 1 tbsp brown sugar, 1 tbsp white wine vinegar, and 2 tbsp water.",
                    "Simmer on low for 15-18 minutes until thick and jammy.",
                    "Let cool slightly and roughly chop to a spreadable consistency."
                  ]
                },
                {
                  "name": "Lemon Dill Goat Cheese Spread",
                  "steps": [
                    "Mix 1 tbsp softened cream cheese and 1 tbsp softened goat cheese together until smooth.",
                    "Stir in 1 tsp fresh dill (finely minced), 1/4 tsp lemon zest, 1/2 tsp fresh lemon juice, 1 mashed roasted garlic clove, and a pinch of salt.",
                    "Mix until evenly combined."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter the potato bun and toast in a skillet until golden on both sides.",
                    "Spread Lemon Dill Goat Cheese Spread on the bottom bun.",
                    "Add a layer of Lemon Herb Bacon Jam on top of the spread.",
                    "Place the fried chicken on the bottom bun.",
                    "Layer sautéed spinach over the chicken.",
                    "Top with fresh mozzarella, allowing it to melt from the heat.",
                    "Spoon Lemon Butter Cream Sauce generously over the cheese and spinach.",
                    "Top with Lemon Herb Romaine Slaw and fresh dill.",
                    "Place top bun and serve immediately."
                  ]
                }
              ],
              "id": "recipe-56",
              "number": 56,
              "title": "Lemon Butter Cream Chicken Sandwich",
              "slug": "lemon-butter-cream-chicken-sandwich",
              "chapterId": "chapter-7"
            },
            {
              "description": "Luxurious French steakhouse on a bun — a silky cognac cream sauce with caramelized shallots and thyme gets spooned over crispy fried chicken, with aged gruyère melting on top. A refined slaw with crispy fried shallots and a cognac-spiked bacon jam create steakhouse elegance.",
