            {
              "usedIn": [
                "Tikka Masala Chicken Sandwich"
              ],
              "description": "A creamy, spiced base that captures the essence of a samosa's filling. Softened cream cheese and goat cheese are mixed with mashed peas, mashed potato, and cooked curry basmati rice, then seasoned with garam masala, cumin, coriander, and bright cilantro. It's an excellent base layer that mimics the comfort of samosa filling.",
              "ingredients": [
                {
                  "item": "cream cheese, softened",
                  "amount": "2 ounces"
                },
                {
                  "item": "fresh goat cheese",
                  "amount": "1 ounce"
                },
                {
                  "item": "frozen peas, thawed and mashed",
                  "amount": "1/4 cup"
                },
                {
                  "item": "cooked curry basmati rice",
                  "amount": "3 tablespoons"
                },
                {
                  "item": "boiled potato, mashed",
                  "amount": "2 tablespoons"
                },
                {
                  "item": "garam masala",
                  "amount": "1 teaspoon"
                },
                {
                  "item": "cumin powder",
                  "amount": "1 teaspoon"
                },
                {
                  "item": "coriander powder",
                  "amount": "1/2 teaspoon"
                },
                {
                  "item": "turmeric powder",
                  "amount": "1/4 teaspoon"
                },
                {
                  "item": "fresh cilantro, minced",
                  "amount": "1 tablespoon"
                },
                {
                  "item": "diced onion, sautéed",
                  "amount": "1 tablespoon"
                },
                {
                  "item": "green chili, minced",
                  "amount": "1 teaspoon"
                },
                {
                  "item": "salt",
                  "amount": "to taste"
                }
              ],
              "directions": [
                "In a small bowl, combine 2 ounces softened cream cheese and 1 ounce fresh goat cheese; mix until smooth.",
                "Mash 1/4 cup thawed frozen peas lightly with a fork and fold into the cream cheese.",
                "Fold in 3 tablespoons cooked curry basmati rice and 2 tablespoons mashed boiled potato.",
                "Stir in 1 teaspoon garam masala, 1 teaspoon cumin powder, 1/2 teaspoon coriander powder, 1/4 teaspoon turmeric, 1 tablespoon minced cilantro, 1 tablespoon sautéed diced onion, and 1 teaspoon minced green chili.",
                "Season with salt to taste. Mix until well combined."
              ],
