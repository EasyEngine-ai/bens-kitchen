              "directionGroups": [
                {
                  "name": "Chicken & Batter",
                  "steps": [
                    "Pat chicken breast dry with paper towels.",
                    "Whisk together buttermilk, egg, and fresh lime juice in a shallow bowl.",
                    "In another shallow bowl, combine flour, potato starch, chicken bouillon powder, chili powder (1/2 teaspoon), ground cumin (1/4 teaspoon), lime zest (1/2 teaspoon), garlic powder (1/4 teaspoon), salt, and black pepper.",
                    "Dip chicken into wet batter, coat thoroughly, then dredge in dry batter, pressing gently to adhere. Let rest on a plate for 5 minutes.",
                    "Heat beef tallow or lard to 350°F in a heavy-bottomed pot or deep skillet, using a thermometer for accuracy.",
                    "Carefully place battered chicken into hot oil and fry for 6-7 minutes until golden brown and internal temperature reaches 165°F.",
                    "Drain on paper towels."
                  ]
                },
                {
                  "name": "Fiesta Adobo Sauce",
                  "steps": [
                    "In a blender, combine mayonnaise (1/2 cup), chipotle peppers in adobo (2 peppers), adobo sauce (1 tablespoon), fresh lime juice (1 tablespoon), minced garlic (1 clove), and chopped cilantro (1 tablespoon).",
                    "Blend until smooth, about 30 seconds.",
                    "Season with salt to taste."
                  ]
                },
                {
                  "name": "Fiesta Slaw",
                  "steps": [
                    "In a small bowl, whisk together mayonnaise (1.5 tablespoons), chili powder (1/4 teaspoon), fresh lime juice (1 tablespoon), honey (1/2 teaspoon), salt, and black pepper.",
                    "In a medium bowl, toss shredded red cabbage (1/4 cup), roasted corn kernels (3 tablespoons), diced red bell pepper (2 tablespoons), and chopped cilantro (1 tablespoon) together.",
                    "Pour the dressing over the slaw and toss to coat.",
                    "Refrigerate until ready to use."
                  ]
                },
                {
                  "name": "Fiesta Chorizo Spread",
                  "steps": [
                    "Cook finely chopped chorizo (2 tablespoons) in a small skillet over medium heat for 2-3 minutes until browned and crumbled.",
                    "Drain excess fat and let cool slightly.",
                    "In a small bowl, combine softened cream cheese (1 tablespoon) and shredded sharp cheddar (1 tablespoon). Mix until smooth.",
                    "Fold in the cooled crumbled chorizo, minced cilantro (1 teaspoon), and salt until well combined."
                  ]
                },
                {
                  "name": "Crispy Fried Shallots",
                  "steps": [
                    "Thinly slice shallots into rings.",
                    "Heat beef tallow or lard to 325°F in a heavy-bottomed pot.",
                    "Fry shallot slices for 2-3 minutes until golden and crispy.",
                    "Drain on paper towels.",
                    "Season lightly with salt."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter and toast the bun lightly until golden, about 1-2 minutes per side.",
                    "Spread the fiesta chorizo spread on the bottom bun.",
                    "Place the fiesta adobo sauce-coated chicken on top.",
                    "Pile the fiesta slaw on the chicken.",
                    "Top with pickled red onions, pickled jalapeños, crumbled cotija cheese, sliced avocado, and crispy fried shallots.",
                    "Cap with the toasted top bun.",
                    "Serve immediately while the chicken is hot."
                  ]
                }
              ],
