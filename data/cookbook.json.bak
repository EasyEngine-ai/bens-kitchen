              "directionGroups": [
                {
                  "name": "Chicken & Batter",
                  "steps": [
                    "Combine 1/2 cup buttermilk and 1 egg in a bowl and whisk until smooth. Set aside wet batter.",
                    "In another bowl, whisk together 1/4 cup all-purpose flour, 1/4 cup potato starch, 1 tbsp chicken bouillon powder, 1/2 tsp grated fresh ginger, 1/4 tsp lime zest, 1/2 tsp salt, and 1/4 tsp black pepper. Set aside dry batter.",
                    "Pat 6-8 oz chicken breasts dry with paper towels.",
                    "Dip chicken into wet batter, coating completely, then dredge in dry batter, shaking off excess.",
                    "Heat 2 cups beef tallow or lard to 350°F in a heavy-bottomed pot or Dutch oven.",
                    "Carefully place breaded chicken into hot fat and fry for 8-10 minutes until golden brown and internal temperature reaches 165°F.",
                    "Remove chicken and drain on paper towels."
                  ]
                },
                {
                  "name": "Toasted Coconut Flakes",
                  "steps": [
                    "Spread sweetened coconut flakes on a baking sheet or in a dry skillet over medium heat.",
                    "Toast 3-5 minutes, stirring frequently, until golden and fragrant.",
                    "Transfer to a plate and set aside."
                  ]
                },
                {
                  "name": "Toasted Macadamia Nuts",
                  "steps": [
                    "Spread 1/2 cup macadamia nut pieces on a baking sheet.",
                    "Toast at 325°F for 5-7 minutes, stirring occasionally, until light golden and fragrant.",
                    "Set aside."
                  ]
                },
                {
                  "name": "Coconut Honey Lime Sauce",
                  "steps": [
                    "In a small bowl, whisk together 3/4 cup full-fat canned coconut cream, 2 tbsp raw honey, 3 tbsp fresh lime juice, 1 tbsp lime zest, 1.5 tsp grated fresh ginger, and 1 minced garlic clove.",
                    "Whisk until smooth and well combined.",
                    "Season with 1/8 tsp salt.",
                    "Sauce should be creamy and thick."
                  ]
                },
                {
                  "name": "Mango Macadamia Arugula Slaw",
                  "steps": [
                    "For the dressing, whisk together 1 tbsp coconut cream, 1 tsp fresh lime juice, 1/2 tsp honey, 1/4 tsp lime zest, and a pinch of salt.",
                    "In a bowl, combine 1/2 cup fresh arugula, 2 tbsp diced fresh mango, 2 tbsp chopped toasted macadamia nuts, 1 tbsp fresh cilantro (chopped), and 3-4 torn fresh mint leaves.",
                    "Pour dressing over and toss gently to coat.",
                    "Refrigerate until ready to serve."
                  ]
                },
                {
                  "name": "Honey Lime Bacon Jam",
                  "steps": [
                    "Cook 4 slices diced thick-cut bacon in a skillet over medium heat until crispy, about 6-7 minutes.",
                    "Drain most fat, leaving about 1 tbsp.",
                    "Add 1 minced shallot, cook 2 minutes.",
                    "Add 1 tbsp fresh lime juice, 1/2 tsp lime zest, 1 tbsp honey, 1/4 tsp fresh ginger (grated), and 2 tbsp water.",
                    "Simmer on low for 15-18 minutes until thick and jammy.",
                    "Let cool and roughly chop to spreadable consistency."
                  ]
                },
                {
                  "name": "Lime Curd Brie Goat Cheese Spread",
                  "steps": [
                    "Mix 1 tbsp softened cream cheese, 1 tbsp softened goat cheese, and 1 tbsp softened Brie (rind removed) until smooth.",
                    "Stir in 1 tsp lime curd, 1/4 tsp lime zest, 1/2 tsp honey, and a pinch of salt.",
                    "Mix until evenly combined."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter the potato bun and toast in a skillet until golden on both sides.",
                    "Spread 2 tbsp Coconut Honey Lime Sauce on the bottom bun.",
                    "Place the fried chicken on top of the sauce.",
                    "Top with 3 tbsp toasted macadamia nuts.",
                    "Sprinkle coconut flakes on top.",
                    "Drizzle an additional 1 tbsp Coconut Honey Lime Sauce over the nuts and flakes.",
                    "Spread remaining sauce on the top bun and place on the sandwich.",
                    "Serve immediately while chicken is warm and nuts are crunchy."
                  ]
                }
              ],
              "id": "recipe-65",
              "number": 65,
              "title": "Coconut Honey Lime Chicken Sandwich",
              "slug": "coconut-honey-lime-chicken-sandwich",
              "chapterId": "chapter-8"
            },
