            {
              "usedIn": [
                "Tikka Masala Chicken Sandwich"
              ],
              "description": "Crispy bacon simmered with onions, garlic, and ginger, then sweetened with brown sugar and spiced with garam masala and cumin. The addition of tomato paste ties it to the sauce while maintaining the richness of bacon, creating a sweet-savory-spicy spread.",
              "ingredients": [
                {
                  "item": "thick-cut bacon, diced",
                  "amount": "4 strips"
                },
                {
                  "item": "yellow onion, diced",
                  "amount": "1/2"
                },
                {
                  "item": "garlic, minced",
                  "amount": "2 cloves"
                },
                {
                  "item": "ginger, minced",
                  "amount": "1 teaspoon"
                },
                {
                  "item": "garam masala",
                  "amount": "1 teaspoon"
                },
                {
                  "item": "cumin powder",
                  "amount": "1/2 teaspoon"
                },
                {
                  "item": "brown sugar",
                  "amount": "2 tablespoons"
                },
                {
                  "item": "apple cider vinegar",
                  "amount": "1 tablespoon"
                },
                {
                  "item": "tomato paste",
                  "amount": "1 teaspoon"
                },
                {
                  "item": "salt",
                  "amount": "to taste"
                }
              ],
              "directions": [
                "In a skillet over medium heat, cook 4 strips of diced thick-cut bacon until crispy, about 6-8 minutes.",
                "Remove half the bacon fat, leaving about 1 tablespoon in the pan.",
                "Add 1/2 diced yellow onion and cook until softened, about 4 minutes.",
                "Add 2 minced garlic cloves and 1 teaspoon minced ginger; cook for 1 minute.",
                "Stir in 1 teaspoon garam masala and 1/2 teaspoon cumin powder; cook for 30 seconds.",
                "Add 2 tablespoons brown sugar, 1 tablespoon apple cider vinegar, and 1 teaspoon tomato paste.",
                "Reduce heat to low and simmer for 8-10 minutes, stirring occasionally, until thick and jammy.",
                "Season with salt to taste. Let cool slightly — it will thicken as it cools."
              ],
              "id": "comp-tikka-masala-bacon-jam",
              "title": "Tikka Masala Bacon Jam",
              "slug": "tikka-masala-bacon-jam",
              "categoryId": "jams-chutneys-relishes"
            },
