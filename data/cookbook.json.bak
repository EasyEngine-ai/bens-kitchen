              "directionGroups": [
                {
                  "name": "Pepperoni Cherry Tomato Jam",
                  "steps": [
                    "In a small skillet over medium heat, cook diced pepperoni for 2-3 minutes until it renders fat and begins to crisp.",
                    "Add finely diced onion and minced garlic, cooking for 2 minutes until softened.",
                    "Add quartered cherry tomatoes, chopped sun-dried tomatoes, brown sugar, Italian seasoning, and red pepper flakes.",
                    "Reduce heat to medium-low and simmer for 10-12 minutes, stirring occasionally, until tomatoes break down and mixture becomes thick and jammy.",
                    "Season with salt. Remove from heat and cool slightly."
                  ]
                },
                {
                  "name": "Vodka Sauce Roasted Garlic Feta Cream Cheese Spread",
                  "steps": [
                    "In a small bowl, combine softened cream cheese and fresh goat cheese, mixing until smooth.",
                    "Fold in crumbled feta cheese, mashed roasted garlic cloves, and diced roasted red peppers.",
                    "Stir in chopped fresh basil and red wine vinegar.",
                    "Season with salt and black pepper. Set aside."
                  ]
                },
                {
                  "name": "Spicy Creamy Vodka Sauce",
                  "steps": [
                    "Heat olive oil in a small saucepan over medium heat.",
                    "Add minced garlic and red pepper flakes, cooking for 1 minute until fragrant.",
                    "Carefully add vodka (it may flame briefly) and cook for 1-2 minutes until reduced by half.",
                    "Add crushed tomatoes and simmer for 5 minutes, stirring occasionally.",
                    "Reduce heat to low and stir in heavy cream.",
                    "Whisk in grated Parmesan cheese until smooth.",
                    "Season with salt and black pepper. Keep warm."
                  ]
                },
                {
                  "name": "Fried Eggplant",
                  "steps": [
                    "Slice 1/3 of a medium eggplant into one 1/4-inch thick slice.",
                    "Lightly salt both sides and let sit for 15 minutes to remove excess moisture.",
                    "Pat dry with paper towels.",
                    "Set up three shallow bowls: combine flour with salt and black pepper in the first, whisk egg in the second, and combine panko breadcrumbs with Italian herbs in the third.",
                    "Coat eggplant slice in flour, dip in egg, then coat with panko mixture, pressing gently to adhere.",
                    "Heat beef tallow or lard to 350°F in a heavy-bottomed pot.",
                    "Carefully place breaded eggplant into hot oil and fry for 3-4 minutes per side until golden brown and crispy.",
                    "Remove to a paper towel-lined plate."
                  ]
                },
                {
                  "name": "Italian Arugula Slaw",
                  "steps": [
                    "In a large bowl, combine baby arugula, shredded red cabbage, halved cherry tomatoes, sliced red onions, and crumbled feta cheese.",
                    "Add sliced pepperoncini peppers, sliced cherry peppers, chopped salami, and crushed croutons.",
                    "In a small bowl, whisk together mayonnaise, red wine vinegar, extra virgin olive oil, and Italian seasoning.",
                    "Pour dressing over vegetables and toss to coat evenly.",
                    "Season with salt and black pepper. Refrigerate until ready to serve."
                  ]
                },
                {
                  "name": "Chicken & Batter",
                  "steps": [
                    "Pound the chicken cutlet to an even 3/4-inch thickness.",
                    "In a shallow bowl, whisk together buttermilk and egg.",
                    "In another shallow bowl, combine all-purpose flour, potato starch, chicken bouillon powder, dried Italian herbs, garlic powder, salt, and black pepper.",
                    "Submerge chicken in wet batter for at least 15 minutes (or up to 4 hours refrigerated).",
                    "Remove from wet batter and dredge thoroughly in dry batter, pressing gently to adhere. For extra crunch, dip back in wet batter and dredge again.",
                    "Heat beef tallow or lard to 350°F in a deep pot or cast iron skillet.",
                    "Carefully place breaded chicken into hot oil and fry for 6-7 minutes until golden brown and internal temperature reaches 165°F.",
                    "Remove with slotted spoon and drain on a wire rack."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter both halves of the sub roll and toast on a griddle or skillet for 1-2 minutes until golden.",
                    "Spread Vodka Sauce Roasted Garlic Feta Cream Cheese Spread on the bottom sub roll.",
                    "Spoon a generous layer of Pepperoni Cherry Tomato Jam over the spread.",
                    "Layer fresh arugula over the jam.",
                    "Place the fried chicken on the arugula.",
                    "Spoon Spicy Creamy Vodka Sauce over the chicken.",
                    "Top with the fried eggplant slice.",
                    "Layer fresh mozzarella slices on the eggplant.",
                    "Add pickled red onions and pile Italian Arugula Slaw on top.",
                    "Drizzle with balsamic glaze and tuck in fresh basil leaves.",
                    "Place top bun and serve immediately while hot."
                  ]
                }
              ],
              "id": "recipe-32",
              "number": 32,
              "title": "Eggplant Parmesan Chicken Sub",
              "slug": "eggplant-parmesan-chicken-sub",
              "chapterId": "chapter-5"
            },
            {
              "description": "This bold Italian sub layers crispy fried chicken cutlet with a rich homemade sun-dried tomato pesto, then piles on an Italian basil slaw bursting with fresh herbs and Italian vegetables. A pepperoni cherry tomato jam anchors the bottom sub roll alongside a vodka sauce feta cream cheese spread, creating a sub that's equal parts fresh, smoky, spicy, and indulgent.",
