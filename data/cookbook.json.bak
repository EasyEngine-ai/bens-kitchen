              "directionGroups": [
                {
                  "name": "Chicken & Batter",
                  "steps": [
                    "Pound the chicken breast to an even 3/4-inch thickness.",
                    "In a shallow bowl, whisk together buttermilk and egg.",
                    "In another shallow bowl, combine all-purpose flour, potato starch, chicken bouillon powder, sesame seeds, salt, and white pepper.",
                    "Heat beef tallow or lard to 350°F in a deep skillet or Dutch oven.",
                    "Dredge the chicken breast in the flour mixture, coating both sides evenly.",
                    "Dip the floured chicken into the wet batter, shaking off excess.",
                    "Carefully place the chicken into the hot fat and fry for 6-8 minutes until golden brown and internal temperature reaches 165°F.",
                    "Remove chicken and drain on paper towels."
                  ]
                },
                {
                  "name": "Creamy Peanut Butter Sauce",
                  "steps": [
                    "In a small saucepan over medium heat, combine creamy peanut butter with soy sauce.",
                    "Add sesame oil, minced ginger, minced garlic, and a pinch of brown sugar.",
                    "Whisk until smooth and simmer for 3-4 minutes until glossy.",
                    "Remove from heat and set aside."
                  ]
                },
                {
                  "name": "Red Cabbage Slaw",
                  "steps": [
                    "In a medium bowl, combine shredded red cabbage and carrots.",
                    "In a small bowl, whisk together sesame oil, rice vinegar, sugar, and sesame salt.",
                    "Pour dressing over vegetables and toss to coat evenly.",
                    "Season with salt and pepper to taste."
                  ]
                },
                {
                  "name": "Fried Shallots",
                  "steps": [
                    "Thinly slice shallots.",
                    "Heat beef tallow or lard to 325°F in a heavy-bottomed skillet.",
                    "Carefully add shallots in small batches and fry for 2-3 minutes until golden brown and crispy.",
                    "Remove with a slotted spoon and drain on paper towels.",
                    "Season lightly with salt."
                  ]
                },
                {
                  "name": "Peanut Butter Cream Cheese Spread",
                  "steps": [
                    "In a small bowl, combine softened cream cheese with creamy peanut butter.",
                    "Add a drizzle of honey and sesame oil.",
                    "Stir until smooth and well combined."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter the cut sides of a yellow potato or brioche bun and toast until golden.",
                    "Spread the Peanut Butter Cream Cheese Spread on the bottom bun.",
                    "Place the hot fried chicken breast on top.",
                    "Pour warm Creamy Peanut Butter Sauce over the chicken.",
                    "Pile the Red Cabbage Slaw on the chicken.",
                    "Top with crispy fried shallots.",
                    "Garnish with fresh cilantro and scallion slices.",
                    "Top with the bun and serve immediately."
                  ]
                }
              ],
              "id": "recipe-21",
              "number": 21,
              "title": "Chinese Peanut Butter Chicken Sandwich",
              "slug": "chinese-peanut-butter-chicken-sandwich",
              "chapterId": "chapter-3"
            },
            {
              "description": "This elegant sandwich showcases the simple beauty of honey and garlic against crispy fried chicken breast. A glossy, sweet-savory glaze made from fragrant garlic, honey, and a touch of soy sauce creates a caramelized crust on the golden-fried chicken. Layers of cool red cabbage slaw, fresh cilantro, and a silky honey-garlic cream cheese spread round out this refined Asian-inspired sandwich that's both sophisticated and deeply satisfying.",
              "aboutSections": [
