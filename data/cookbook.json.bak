                      "amount": "{\"all-purpose flour\": \"1/4 cup\", \"potato starch\": \"1/4 cup\", \"chicken bouillon powder\": \"1 tsp\", \"madras curry powder\": \"1 tsp\", \"ground allspice\": \"1/4 tsp\", \"salt\": \"1/2 tsp\", \"black pepper\": \"1/4 tsp\"}"
