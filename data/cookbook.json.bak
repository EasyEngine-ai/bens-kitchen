                "Jalapeño Poppers Chicken Sandwich"
              ],
              "description": "Thick-cut bacon coated with maple syrup and brown sugar, then baked until crispy and candied. Sweet, smoky, and irresistibly crunchy.",
              "ingredients": [
                {
                  "item": "Thick-cut bacon strips",
                  "amount": "2 strips"
                },
                {
                  "item": "Brown sugar",
                  "amount": "1 tablespoon"
                },
                {
                  "item": "Black pepper",
                  "amount": "1/8 teaspoon"
                }
              ],
              "directions": [
                "Preheat oven to 375°F.",
                "Line a baking sheet with parchment paper.",
                "In a small bowl, combine maple syrup and brown sugar.",
                "Lay thick-cut bacon strips on the baking sheet.",
                "Brush or drizzle the maple mixture evenly over the bacon.",
                "Bake for 15-20 minutes until the bacon is crispy and caramelized.",
                "Remove from oven and let cool on a paper towel to crisp up further."
              ],
              "id": "comp-candied-bacon",
              "title": "Candied Bacon",
              "slug": "candied-bacon",
              "categoryId": "special-components-toppings"
