              "directionGroups": [
                {
                  "name": "Chicken & Batter",
                  "steps": [
                    "Pat chicken breast dry with paper towels.",
                    "Whisk together buttermilk, egg, and fresh lime juice in a shallow bowl.",
                    "In another shallow bowl, combine flour, potato starch, chicken bouillon powder, chili powder, lime zest, salt, and black pepper.",
                    "Dip chicken into wet batter, coat thoroughly, then dredge in dry batter, pressing gently to adhere. Let rest on a plate for 5 minutes.",
                    "Heat beef tallow or lard to 350°F in a heavy-bottomed pot or deep skillet, using a thermometer for accuracy.",
                    "Carefully place battered chicken into hot oil and fry for 6-7 minutes until golden brown and internal temperature reaches 165°F.",
                    "Drain on paper towels."
                  ]
                },
                {
                  "name": "Elote Crema Sauce",
                  "steps": [
                    "Whisk together Mexican crema, finely grated cotija cheese, chili powder, fresh lime juice, lime zest, minced garlic, and salt until well combined.",
                    "Taste and adjust seasonings as needed."
                  ]
                },
                {
                  "name": "Elote Dip Slaw",
                  "steps": [
                    "If using fresh corn, cut kernels from the cob.",
                    "Heat a dry skillet or cast iron over high heat and add corn kernels.",
                    "Cook without stirring for 2-3 minutes until charred, then stir and char another 1-2 minutes. Let cool.",
                    "In a medium bowl, toss charred corn, shredded romaine, shredded green cabbage, crumbled cotija, chopped cilantro, and sliced jalapeño together.",
                    "In a small bowl, whisk Mexican crema or mayo, fresh lime juice, chili powder, smoked paprika, garlic powder, salt, and black pepper.",
                    "Pour dressing over the slaw and toss to coat.",
                    "Refrigerate until ready to use."
                  ]
                },
                {
                  "name": "Chorizo Goat Cheese Spread",
                  "steps": [
                    "Cook chopped chorizo in a small skillet over medium heat for 3-4 minutes until browned and crumbled.",
                    "Drain excess fat and let cool.",
                    "In a small bowl, combine softened cream cheese and fresh goat cheese. Mix until smooth.",
                    "Fold in the cooled crumbled chorizo, chili powder, garlic powder, and salt until well combined."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter and toast the bun lightly until golden, about 1-2 minutes per side.",
                    "Spread the chorizo goat cheese spread on the bottom bun.",
                    "Place the elote crema-coated chicken on top.",
                    "Pile the elote dip slaw on the chicken.",
                    "Sprinkle with extra crumbled cotija and fresh cilantro.",
                    "Top with pickled jalapeños.",
                    "Cap with the toasted top bun.",
                    "Serve immediately while the chicken is hot."
                  ]
                }
              ],
