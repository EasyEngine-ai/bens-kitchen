            {
              "description": "South Carolina's legendary mustard-based BBQ tradition meets crispy fried chicken. Instead of making your own, we're using Cattlemen's Carolina Tangy Gold BBQ Sauce — made by the same folks behind Frank's RedHot and easy to find at any grocery store. A sweet honey coleslaw studded with candied jalapeños adds cool crunch against the tangy mustard heat.",
              "aboutSections": [
                {
                  "name": "Carolina Gold Mustard BBQ Sauce",
                  "description": "A tangy, mustard-forward BBQ sauce made with yellow mustard, apple cider vinegar, brown sugar, and spices. Bright and slightly sharp, it's the signature flavor of South Carolina low country BBQ."
                },
                {
                  "name": "Carolina Slaw",
                  "description": "A crisp slaw of shredded cabbage and carrots dressed in a vinegar-mustard base with a touch of sugar, providing sharp acidity and crunch."
                },
                {
                  "name": "Carolina Bacon Jam",
                  "description": "Crispy bacon rendered with onions, garlic, brown sugar, and apple cider vinegar to create a savory-sweet jam with smoky depth."
                },
                {
                  "name": "Carolina Cheese Spread",
                  "description": "Creamy sharp cheddar blended with the mustard BBQ sauce for a smooth, tangy spread with excellent cheese flavor."
                }
              ],
              "ingredientGroups": [
                {
                  "name": "Chicken & Batter",
                  "ingredients": [
                    {
                      "item": "Boneless, skinless chicken breast",
                      "amount": "6-8 oz"
                    },
