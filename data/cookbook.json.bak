                {
                  "name": "Sautéed Mushrooms",
                  "steps": [
                    "Slice 1 cup cremini mushrooms.",
                    "Heat 1 tbsp unsalted butter in a skillet over medium-high heat.",
                    "Add 1 minced garlic clove, cook 30 seconds.",
                    "Add sliced mushrooms and 2 fresh thyme sprigs, cook 4-5 minutes until golden.",
                    "Season with 1/8 tsp salt and a pinch of black pepper.",
                    "Discard thyme sprigs and set aside. Reserve 1 tbsp finely minced for goat cheese spread."
                  ]
                },
                {
                  "name": "Marsala Mushroom Slaw",
                  "steps": [
                    "Whisk together 2 tbsp Marsala sauce, 1 tbsp mayonnaise, 1/2 tsp Dijon mustard, 1 tbsp fresh lemon juice, and a pinch of salt for the dressing.",
                    "In a bowl, combine 1/2 cup shredded red cabbage, 1/4 cup thinly sliced raw cremini mushrooms, 1 tbsp shredded aged provolone, 1 tsp fresh sage (thinly sliced), 1 tbsp fresh parsley (chopped), and 1 tbsp crispy prosciutto bits.",
                    "Pour dressing over and toss to coat.",
                    "Refrigerate until ready to serve."
                  ]
                },
                {
                  "name": "Marsala Prosciutto Bacon Jam",
                  "steps": [
                    "Cook 4 slices diced thick-cut bacon in a skillet over medium heat until crispy, about 6-7 minutes.",
                    "Add 1 oz diced prosciutto, cook 1 minute.",
                    "Drain most fat, leaving about 1 tbsp in the pan.",
                    "Add 1 minced shallot, cook 2 minutes.",
                    "Add 1/4 cup finely diced cremini mushrooms, cook 2 minutes.",
                    "Add 1/2 tsp fresh sage (minced).",
                    "Deglaze with 2 tbsp dry Marsala wine, simmer 1 minute.",
                    "Add 1 tbsp brown sugar, 1 tbsp balsamic vinegar, and 2 tbsp water.",
                    "Simmer on low for 15-18 minutes until thick and jammy.",
                    "Let cool slightly and roughly chop to a spreadable consistency."
                  ]
                },
                {
                  "name": "Sage Mushroom Goat Cheese Spread",
                  "steps": [
                    "Mix 1 tbsp softened cream cheese and 1 tbsp softened goat cheese together until smooth.",
                    "Stir in 1 tbsp finely minced sautéed mushrooms, 1/2 tsp fresh sage (finely minced), 1 mashed roasted garlic clove, and a pinch of salt.",
                    "Mix until evenly combined."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter the potato bun and toast in a skillet until golden on both sides.",
                    "Spread Sage Mushroom Goat Cheese Spread on the bottom bun.",
                    "Add a layer of Marsala Prosciutto Bacon Jam on top of the spread.",
                    "Place the fried chicken on the bottom bun.",
                    "Layer sautéed mushrooms over the chicken.",
                    "Top with fresh mozzarella and aged provolone, allowing them to melt from the heat.",
                    "Arrange crispy prosciutto on top of the cheese.",
                    "Spoon Creamy Marsala Sauce generously over everything.",
                    "Top with Marsala Mushroom Slaw and fresh sage.",
                    "Place top bun and serve immediately."
                  ]
                }
              ],
