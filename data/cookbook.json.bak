              "directionGroups": [
                {
                  "name": "Jerk Marinade",
                  "steps": [
                    "Combine fresh thyme leaves, ground allspice, Scotch bonnet pepper (seeds removed), chopped scallions, minced garlic, grated ginger, low-sodium soy sauce, brown sugar, fresh lime juice, olive oil, black pepper, and salt in a food processor.",
                    "Pulse until it reaches a chunky paste consistency.",
                    "Rub all over the chicken breast, covering completely.",
                    "Marinate for at least 30 minutes at room temperature or up to 4 hours refrigerated."
                  ]
                },
                {
                  "name": "Chicken & Batter",
                  "steps": [
                    "Pat marinated chicken breast dry with paper towels.",
                    "Whisk together buttermilk, egg, and fresh lime juice in a shallow bowl.",
                    "In another shallow bowl, combine flour, potato starch, chicken bouillon powder, ground allspice, dried thyme, salt, and black pepper.",
                    "Dip chicken into wet batter, coat thoroughly, then dredge in dry batter, pressing gently to adhere. Let rest on a plate for 5 minutes.",
                    "Heat beef tallow or lard to 350°F in a heavy-bottomed pot or deep skillet, using a thermometer for accuracy.",
                    "Carefully place battered chicken into hot oil and fry for 6-7 minutes until golden brown and internal temperature reaches 165°F.",
                    "Drain on paper towels."
                  ]
                },
                {
                  "name": "Jerk Mayo",
                  "steps": [
                    "Whisk together mayonnaise, jerk paste or sauce, and fresh lime juice in a small bowl.",
                    "Taste and adjust seasoning as needed."
                  ]
                },
                {
                  "name": "Caribbean Mango Slaw",
                  "steps": [
                    "In a medium bowl, toss shredded green and red cabbage, diced fresh mango, diced fresh pineapple, sliced red onion, and chopped cilantro together.",
                    "In a small bowl, whisk fresh lime juice, olive oil, honey, salt, and black pepper.",
                    "Pour dressing over the slaw and toss to coat.",
                    "Refrigerate until ready to use."
                  ]
                },
                {
                  "name": "Mango Habanero Bacon Jam",
                  "steps": [
                    "In a small skillet, cook diced bacon over medium heat for 3-4 minutes until it begins to crisp and render fat.",
                    "Add diced onion, minced garlic, and minced habanero, cooking for 2 minutes until softened.",
                    "Add diced fresh mango, brown sugar, apple cider vinegar, and ground allspice.",
                    "Reduce heat to medium-low and cook, stirring occasionally, for 10-12 minutes until the mango breaks down and the mixture becomes thick and jammy.",
                    "Season with salt. Remove from heat and let cool slightly."
                  ]
                },
                {
                  "name": "Jerk-Spiced Goat Cheese Spread",
                  "steps": [
                    "In a small bowl, combine softened cream cheese and fresh goat cheese. Mix until smooth.",
                    "Fold in jerk seasoning, fresh lime juice, garlic powder, and salt until well combined."
                  ]
                },
                {
                  "name": "Candied Jalapeños",
                  "steps": [
                    "In a small saucepan, combine sugar, apple cider vinegar, and water over medium heat.",
                    "Stir until the sugar dissolves and the mixture comes to a simmer.",
                    "Add sliced jalapeño rings and cook for 5-7 minutes, stirring occasionally.",
                    "The liquid should become thick and syrupy and the jalapeños should be glossy.",
                    "Remove from heat and let cool."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter and toast the bun lightly until golden, about 1-2 minutes per side.",
                    "Spread the jerk-spiced goat cheese spread on the bottom bun.",
                    "Spoon mango habanero bacon jam on top.",
                    "Place the jerk mayo-coated chicken on the jam.",
                    "Pile the Caribbean mango slaw on the chicken.",
                    "Top with pickled red onions and candied jalapeños.",
                    "Cap with the toasted top bun.",
                    "Serve immediately while the chicken is hot."
                  ]
                }
              ],
              "id": "recipe-42",
              "number": 42,
              "title": "Caribbean Jerk Chicken Sandwich - Traditional Fiery",
              "slug": "caribbean-jerk-chicken-sandwich-traditional-fiery",
              "chapterId": "chapter-6"
            },
            {
              "description": "Fragrant with warming Caribbean spices, this sandwich features chicken fried to golden perfection and topped with a creamy, complex curry sauce infused with coconut milk and Scotch bonnet heat. A Caribbean curry slaw with mango and pineapple adds tropical sweetness and crunch, while the mango curry bacon jam brings depth and spicy-sweet complexity. The curry-spiced goat cheese spread ties everything together with aromatic warmth. Finished with mango chutney, pickled red onions, candied jalapeños, crispy fried shallots, and fresh cilantro for layers of texture and flavor.",
              "aboutSections": [
                {
                  "name": "Chicken & Batter",
                  "description": "A warmly spiced fried crust featuring madras curry powder and allspice for aromatic, authentic Caribbean flavor."
                },
                {
                  "name": "Caribbean Curry Sauce",
                  "description": "A silky, complex sauce of coconut milk enriched with madras curry, allspice, thyme, ginger, garlic, and Scotch bonnet heat."
                },
                {
                  "name": "Caribbean Curry Slaw",
                  "description": "A tropical slaw of shredded cabbage, fresh mango, pineapple, carrots, and cilantro tossed in a curry-lime dressing."
                },
                {
                  "name": "Mango Curry Bacon Jam",
                  "description": "A sophisticated jam combining crispy bacon, fresh mango, madras curry, and allspice for complex sweet-spicy flavor."
                },
                {
                  "name": "Curry-Spiced Goat Cheese Spread",
                  "description": "A creamy spread of goat cheese and cream cheese infused with madras curry, turmeric, and honey for warm, aromatic depth."
                },
                {
                  "name": "Candied Jalapeños",
                  "description": "A key component that complements the chicken and sauce."
                }
              ],
              "ingredientGroups": [
                {
