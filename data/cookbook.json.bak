              "directionGroups": [
                {
                  "name": "Chicken & Batter",
                  "steps": [
                    "Combine 1/2 cup buttermilk and 1 egg in a bowl and whisk until smooth. Set aside wet batter.",
                    "In another bowl, whisk together 1/4 cup all-purpose flour, 1/4 cup potato starch, 1 tbsp chicken bouillon powder, 1/2 tsp orange zest, 1/2 tsp salt, and 1/4 tsp black pepper. Set aside dry batter.",
                    "Pat 6-8 oz chicken breasts dry with paper towels.",
                    "Dip chicken into wet batter, coating completely, then dredge in dry batter, shaking off excess.",
                    "Heat 2 cups beef tallow or lard to 350°F in a heavy-bottomed pot or Dutch oven.",
                    "Carefully place breaded chicken into hot fat and fry for 8-10 minutes until golden brown and internal temperature reaches 165°F.",
                    "Remove chicken and drain on paper towels."
                  ]
                },
                {
                  "name": "Cinnamon Candied Walnuts",
                  "steps": [
                    "In a small skillet, melt 1 tbsp unsalted butter over medium heat.",
                    "Add 1/2 cup walnut halves, 2 tbsp brown sugar, 1/4 tsp ground cinnamon, and a pinch of sea salt.",
                    "Toss constantly for 4-5 minutes until walnuts are coated and sugar is caramelized.",
                    "Transfer to parchment-lined plate to cool.",
                    "Walnuts will crisp as they cool."
                  ]
                },
                {
                  "name": "Cranberry Orange Spiced Compote",
                  "steps": [
                    "In a small saucepan, combine 1 cup fresh cranberries, 1/2 cup fresh orange juice, 1 tsp orange zest, 2 tbsp brown sugar, and 1 tbsp honey.",
                    "Bring to a simmer over medium heat and cook 8-10 minutes, stirring occasionally, until cranberries burst and sauce thickens.",
                    "Add 1/4 tsp ground cinnamon, a pinch of ground nutmeg, and 1/4 tsp grated fresh ginger.",
                    "Simmer 1 more minute.",
                    "Season with a pinch of salt.",
                    "Remove from heat and let cool to room temperature."
                  ]
                },
                {
                  "name": "Cranberry Orange Arugula Slaw",
                  "steps": [
                    "For the dressing, whisk together 1 tbsp fresh orange juice, 1 tbsp extra virgin olive oil, 1/2 tsp honey, a pinch of salt, and a pinch of ground cinnamon.",
                    "In a bowl, combine 1/2 cup fresh arugula, 1 tbsp dried cranberries, 1 tbsp chopped candied walnuts, 1 tbsp shaved Brie, and 1/4 tsp fresh orange zest.",
                    "Pour dressing over and toss gently to coat.",
                    "Refrigerate until ready to serve."
                  ]
                },
                {
                  "name": "Cranberry Orange Bacon Jam",
                  "steps": [
                    "Cook 4 slices diced thick-cut bacon in a skillet over medium heat until crispy, about 6-7 minutes.",
                    "Drain most fat, leaving about 1 tbsp.",
                    "Add 1 minced shallot, cook 2 minutes.",
                    "Add 1/4 cup roughly chopped fresh cranberries, 1/2 tsp orange zest, 1 tbsp fresh orange juice, 1 tbsp brown sugar, 1 tbsp apple cider vinegar, a pinch of ground cinnamon, and 2 tbsp water.",
                    "Simmer on low for 15-18 minutes until thick and jammy.",
                    "Let cool and roughly chop to spreadable consistency."
                  ]
                },
                {
                  "name": "Orange Spiced Brie Goat Cheese Spread",
                  "steps": [
                    "Mix 1 tbsp softened cream cheese, 1 tbsp softened goat cheese, and 1 tbsp softened Brie (rind removed) until smooth.",
                    "Stir in 1/4 tsp orange zest, a pinch of ground cinnamon, 1/2 tsp honey, and a pinch of salt.",
                    "Mix until evenly combined."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter the potato bun and toast in a skillet until golden on both sides.",
                    "Spread 1.5 tbsp Cranberry Orange Spiced Compote on the bottom bun.",
                    "Place the fried chicken on top of the compote.",
                    "Top with 2 oz crumbled creamy goat cheese or Brie slices.",
                    "Top with an additional 1.5 tbsp Cranberry Orange Spiced Compote.",
                    "Scatter candied walnuts (about 3 tbsp worth) on top for crunch.",
                    "Spread remaining compote on the top bun and place it on the sandwich.",
                    "Serve immediately while chicken is warm and walnuts are crispy."
                  ]
                }
              ],
