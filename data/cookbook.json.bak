            {
              "usedIn": [
                "Red Wine Onion Gravy Chicken Sandwich"
              ],
              "description": "A complex, umami-rich sauce made from A1 sauce, mayo, pepperoncini juice, lemon juice, roasted garlic, charred peppers and onions, fresh herbs, and beef bouillon. This is the signature sauce on the chicken.",
              "ingredients": [
                {
                  "item": "A1 Sauce",
                  "amount": "2.5 tbsp"
                },
                {
                  "item": "mayonnaise",
                  "amount": "1.5 tbsp"
                },
                {
                  "item": "pepperoncini juice",
                  "amount": "1.5 tsp"
                },
                {
                  "item": "fresh lemon juice",
                  "amount": "1.5 tsp"
                },
                {
                  "item": "beef stock",
                  "amount": "1 tbsp"
                },
                {
                  "item": "unsalted butter",
                  "amount": "1.5 tbsp"
                },
                {
                  "item": "shallots, minced",
                  "amount": "2 tbsp"
                },
                {
                  "item": "roasted and charred garlic cloves, mashed",
                  "amount": "4"
                },
                {
                  "item": "roasted and charred red bell pepper, diced",
                  "amount": "3 tbsp"
                },
                {
                  "item": "roasted and charred red onion, diced",
                  "amount": "3 tbsp"
                },
                {
                  "item": "fresh thyme, minced",
                  "amount": "1.5 tsp"
                },
                {
                  "item": "fresh parsley, minced",
                  "amount": "1.5 tsp"
                },
                {
                  "item": "fresh rosemary, minced",
                  "amount": "1 tsp"
                },
                {
                  "item": "beef bouillon",
                  "amount": "1/2 tsp"
                },
                {
                  "item": "salt",
                  "amount": "to taste"
                },
                {
                  "item": "coarse black pepper",
                  "amount": "1 tsp"
                },
                {
                  "item": "Dijon mustard (optional)",
                  "amount": "1 tsp"
                },
                {
                  "item": "prepared horseradish (optional)",
                  "amount": "1/2 tsp"
                }
              ],
              "directions": [
                "In a heavy skillet, melt butter over medium heat.",
                "Add minced shallots and cook until softened, about 3 minutes.",
                "Add mashed roasted garlic, diced charred red pepper, and diced charred red onion.",
                "Cook for 2 minutes, stirring frequently.",
                "Reduce heat to low and add A1 sauce, mayonnaise, pepperoncini juice, lemon juice, and beef stock.",
                "Whisk in fresh thyme, parsley, rosemary, and beef bouillon.",
                "Simmer gently for 5 minutes, stirring occasionally.",
                "Remove from heat and season with salt, coarse black pepper, and optional Dijon mustard or horseradish.",
                "Keep warm until ready to use."
              ],
              "id": "comp-special-steak-sauce",
              "title": "Special Steak Sauce",
              "slug": "special-steak-sauce",
              "categoryId": "sauces-glazes-aiolis"
            },
            {
              "usedIn": [
                "Red Wine Onion Gravy Chicken Sandwich"
              ],
              "description": "A rich, creamy gravy made from beef drippings or butter, flour, beef stock, heavy cream, and cracked black peppercorns. Drizzled over the sandwich for an elegant finish.",
              "ingredients": [
                {
                  "item": "beef drippings or unsalted butter",
                  "amount": "2.5 tbsp"
                },
                {
                  "item": "all-purpose flour",
                  "amount": "1.5 tbsp"
                },
                {
                  "item": "beef stock",
                  "amount": "3/4 cup"
                },
                {
                  "item": "heavy cream",
                  "amount": "2.5 tbsp"
                },
                {
                  "item": "cracked black peppercorns",
                  "amount": "1.5 tsp"
                },
                {
                  "item": "Worcestershire sauce",
                  "amount": "1 tsp"
                },
                {
                  "item": "salt",
                  "amount": "to taste"
                }
              ],
              "directions": [
                "In a small saucepan over medium-low heat, melt beef drippings or butter.",
                "Whisk in flour to create a roux and cook for 1-2 minutes, stirring constantly.",
                "Slowly whisk in beef stock, stirring to avoid lumps.",
                "Add cracked peppercorns and Worcestershire sauce.",
                "Simmer for 3-4 minutes until thickened, stirring occasionally.",
                "Reduce heat to low and add heavy cream, whisking to combine.",
                "Simmer for 2 more minutes.",
                "Season with salt to taste.",
                "Keep warm in a small pitcher or gravy boat for drizzling."
              ],
              "id": "comp-peppercorn-gravy",
              "title": "Peppercorn Gravy",
