            {
              "usedIn": [
                "Eggplant Parmesan Chicken Sub"
              ],
              "description": "A slice of eggplant dredged in flour and panko breadcrumbs, fried until crispy and golden on the outside while tender within.",
              "ingredients": [
                {
                  "item": "medium eggplant",
                  "amount": "1/3 (one 1/4-inch thick slice)"
                },
                {
                  "item": "all-purpose flour",
                  "amount": "3 tablespoons"
                },
                {
                  "item": "panko breadcrumbs",
                  "amount": "3 tablespoons"
                },
                {
                  "item": "large egg",
                  "amount": "1"
                },
                {
                  "item": "salt",
                  "amount": "1/4 teaspoon"
                },
                {
                  "item": "black pepper",
                  "amount": "1/8 teaspoon"
                },
                {
                  "item": "dried Italian herbs",
                  "amount": "1/4 teaspoon"
                }
              ],
              "directions": [
                "Slice 1/3 of a medium eggplant into one 1/4-inch thick slice.",
                "Lightly salt both sides and let sit for 15 minutes to remove excess moisture.",
                "Pat dry with paper towels.",
                "Set up three shallow bowls: combine flour with salt and black pepper in the first, whisk egg in the second, and combine panko breadcrumbs with Italian herbs in the third.",
                "Coat eggplant slice in flour, dip in egg, then coat with panko mixture, pressing gently to adhere.",
                "Heat beef tallow or lard to 350°F in a heavy-bottomed pot.",
                "Carefully place breaded eggplant into hot oil and fry for 3-4 minutes per side until golden brown and crispy.",
                "Remove to a paper towel-lined plate."
              ],
