              "directionGroups": [
                {
                  "name": "Chicken & Batter",
                  "steps": [
                    "Combine 1/2 cup buttermilk and 1 egg in a bowl and whisk until smooth. Set aside wet batter.",
                    "In another bowl, whisk together 1/4 cup all-purpose flour, 1/4 cup potato starch, 1 tsp chicken bouillon powder, 1/2 tsp freshly cracked black pepper, and 1/2 tsp salt. Set aside dry batter.",
                    "Pat 6-8 oz chicken breasts dry with paper towels.",
                    "Dip chicken into wet batter, coating completely, then dredge in dry batter, shaking off excess.",
                    "Heat 2 cups beef tallow or lard to 350°F in a heavy-bottomed pot or Dutch oven.",
                    "Carefully place breaded chicken into hot fat and fry for 8-10 minutes until golden brown and internal temperature reaches 165°F.",
                    "Remove chicken and drain on paper towels."
                  ]
                },
                {
                  "name": "Crispy Guanciale",
                  "steps": [
                    "Cook 2.5 oz (about 4-5 slices) thinly sliced guanciale in a skillet over medium heat for 4-5 minutes per side until crispy and rendered.",
                    "Transfer to paper towels.",
                    "Break into pieces once cooled. Reserve 1 tbsp crumbled bits for the slaw and 2 oz diced guanciale for the jam."
                  ]
                },
                {
                  "name": "Cacio e Pepe Sauce",
                  "steps": [
                    "Heat 2 tbsp unsalted butter in a saucepan over medium heat.",
                    "Add 1 tbsp freshly cracked black pepper, toast 1 minute, stirring constantly.",
                    "Pour in 1/2 cup chicken broth and 2 tbsp starchy pasta water (or additional broth), simmer 2 minutes.",
                    "Remove from heat and cool slightly for 1 minute.",
                    "In a small bowl, whisk 1 egg yolk.",
                    "Slowly whisk the warm broth into the egg yolk while continuously stirring to avoid scrambling.",
                    "Add 3/4 cup grated Pecorino Romano in two additions, whisking constantly until smooth and creamy.",
                    "Season with 1/4 tsp salt and a pinch of white pepper.",
                    "Keep warm — do not boil. Reserve 2 tbsp for slaw dressing."
                  ]
                },
                {
                  "name": "Peppery Arugula Pecorino Slaw",
                  "steps": [
                    "Whisk together 2 tbsp cacio e pepe sauce, 1 tbsp mayonnaise, 1 tbsp fresh lemon juice, 1/2 tsp Dijon mustard, and a pinch of salt for the dressing.",
                    "In a bowl, toss 1/2 cup fresh arugula, 1/4 cup shredded red cabbage, 2 tbsp shaved Pecorino Romano, 1/2 tsp freshly cracked black pepper, and 1 tbsp guanciale bits.",
                    "Pour dressing over and toss to coat.",
                    "Refrigerate until ready to serve."
                  ]
                },
                {
                  "name": "Guanciale Black Pepper Jam",
                  "steps": [
                    "Cook 2 oz diced guanciale and 2 slices diced thick-cut bacon in a skillet over medium heat until crispy, about 6-7 minutes.",
                    "Drain most fat, leaving about 1 tbsp in the pan.",
                    "Add 1 minced shallot, cook 2 minutes.",
                    "Add 1 tsp freshly cracked black pepper and 1/2 tsp fresh thyme leaves, toast 30 seconds.",
                    "Deglaze with 1 tbsp dry white wine, simmer 30 seconds.",
                    "Add 1 tbsp brown sugar, 1 tbsp balsamic vinegar, and 2 tbsp water.",
                    "Simmer on low for 15-18 minutes until thick and jammy.",
                    "Let cool slightly and roughly chop to a spreadable consistency."
                  ]
                },
                {
                  "name": "Cracked Pepper Pecorino Goat Cheese Spread",
                  "steps": [
                    "Mix 1 tbsp softened cream cheese and 1 tbsp softened goat cheese together until smooth.",
                    "Stir in 1 tbsp grated Pecorino Romano, 1/2 tsp freshly cracked black pepper, 1 mashed roasted garlic clove, and a pinch of salt.",
                    "Mix until evenly combined."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter the potato bun and toast in a skillet until golden on both sides.",
                    "Spread Cracked Pepper Pecorino Goat Cheese Spread on the bottom bun.",
                    "Add a layer of Guanciale Black Pepper Jam on top of the spread.",
                    "Place the fried chicken on the bottom bun.",
                    "Layer crispy guanciale pieces over the chicken.",
                    "Spoon Cacio e Pepe Sauce generously over everything.",
                    "Top with Pecorino Romano shavings and a final crack of black pepper.",
                    "Top with Peppery Arugula Pecorino Slaw.",
                    "Place top bun and serve immediately."
                  ]
                }
              ],
