                    },
                    {
                      "item": "Roasted Garlic Cream Sauce (spooned over chicken)",
                      "amount": ""
                    },
                    {
                      "item": "Fresh mozzarella (melted over chicken)",
                      "amount": ""
                    },
                    {
                      "item": "Crispy garlic chips",
                      "amount": ""
                    },
                    {
                      "item": "Fresh thyme",
                      "amount": ""
                    }
                  ]
                },
                {
                  "name": "Roasted Garlic Mashed Potato Schmear",
                  "ingredients": [
                    {
                      "item": "russet potato (peeled, cubed)",
                      "amount": "1 small potato"
                    },
                    {
                      "item": "unsalted butter",
                      "amount": "1 tbsp"
                    },
                    {
                      "item": "heavy cream",
                      "amount": "1 tbsp"
                    },
                    {
                      "item": "roasted garlic (mashed)",
                      "amount": "2 cloves"
                    },
                    {
                      "item": "grated Parmesan cheese",
                      "amount": "1 tbsp"
                    },
                    {
                      "item": "salt",
                      "amount": "pinch"
                    },
                    {
                      "item": "white pepper",
                      "amount": "pinch"
                    }
                  ]
                }
              ],
              "directionGroups": [
                {
                  "name": "Roasted Garlic",
                  "steps": [
                    "Preheat oven to 400°F.",
                    "Cut the top off 1 whole garlic bulb.",
                    "Drizzle with 1/2 tbsp olive oil, season with a pinch each of salt and black pepper.",
                    "Place 2 fresh thyme sprigs on top.",
                    "Wrap in foil and roast 30-35 minutes until cloves are soft and golden.",
                    "Let cool, then squeeze out all cloves.",
                    "Reserve for use across sauce, jam, and spread."
                  ]
                },
                {
                  "name": "Chicken & Batter",
                  "steps": [
                    "Combine 1/2 cup buttermilk and 1 egg in a bowl and whisk until smooth. Set aside wet batter.",
                    "In another bowl, whisk together 1/4 cup all-purpose flour, 1/4 cup potato starch, 1 tsp chicken bouillon powder, 1/2 tsp garlic powder, 1/2 tsp salt, and 1/4 tsp white pepper. Set aside dry batter.",
                    "Pat 6-8 oz chicken breasts dry with paper towels.",
                    "Dip chicken into wet batter, coating completely, then dredge in dry batter, shaking off excess.",
                    "Heat 2 cups beef tallow or lard to 350°F in a heavy-bottomed pot or Dutch oven.",
                    "Carefully place breaded chicken into hot fat and fry for 8-10 minutes until golden brown and internal temperature reaches 165°F.",
                    "Remove chicken and drain on paper towels."
                  ]
                },
                {
                  "name": "Roasted Garlic Cream Sauce",
                  "steps": [
                    "Heat 2 tbsp unsalted butter in a saucepan over medium-low heat.",
                    "Add 6-8 roasted garlic cloves, gently mashing as they warm, cook 1 minute.",
                    "Slowly whisk in 3/4 cup heavy cream.",
                    "Add 2 tbsp chicken broth, simmer gently 2 minutes.",
                    "Blend until smooth with immersion blender (or transfer to blender and return to pan).",
                    "Stir in 1 tbsp fresh thyme (minced) and 2 tbsp grated Parmesan.",
                    "Season with 1/4 tsp salt and 1/8 tsp white pepper.",
                    "Keep warm and reserve 2 tbsp for slaw dressing."
                  ]
                },
                {
                  "name": "Roasted Garlic Mashed Potato Schmear",
                  "steps": [
                    "Boil 1 small cubed russet potato (peeled) in salted water for 12-15 minutes until fork-tender.",
                    "Drain well.",
                    "Mash with 1 tbsp unsalted butter, 1 tbsp heavy cream, 2 mashed roasted garlic cloves, 1 tbsp grated Parmesan, a pinch of salt, and a pinch of white pepper.",
                    "Keep thick enough to hold on the bun (thicker than regular mashed potatoes).",
                    "Set aside."
                  ]
                },
                {
                  "name": "Crispy Garlic Chips",
                  "steps": [
                    "Slice 4-5 fresh garlic cloves paper thin.",
                    "Heat 2 tbsp olive oil in a small pan over medium-low heat.",
                    "Add garlic slices and fry 1-2 minutes, watching carefully, until just golden (they burn quickly).",
                    "Remove immediately with a slotted spoon to paper towels.",
                    "Reserve 1 tbsp for the slaw."
                  ]
                },
                {
                  "name": "Roasted Garlic Parmesan Slaw",
                  "steps": [
                    "Whisk together 2 tbsp roasted garlic cream sauce, 1 tbsp mayonnaise, 1 tbsp fresh lemon juice, 1/2 tsp Dijon mustard, and a pinch of salt for the dressing.",
                    "In a bowl, combine 1/2 cup shredded romaine, 1/4 cup fresh baby spinach, 2 tbsp shaved Parmesan, 1 tbsp crispy garlic chips, 1/2 tsp fresh thyme leaves, and 1 tbsp fresh parsley (chopped).",
                    "Pour dressing over and toss to coat.",
                    "Refrigerate until ready to serve."
                  ]
                },
                {
                  "name": "Roasted Garlic Bacon Jam",
                  "steps": [
                    "Cook 4 slices diced thick-cut bacon in a skillet over medium heat until crispy, about 6-7 minutes.",
                    "Drain most fat, leaving about 1 tbsp in the pan.",
                    "Add 1 minced shallot, cook 2 minutes.",
                    "Add 3-4 mashed roasted garlic cloves and 1/2 tsp fresh thyme leaves, cook 1 minute.",
                    "Add 1 tbsp grated Parmesan, 1 tbsp brown sugar, 1 tbsp balsamic vinegar, and 2 tbsp water.",
                    "Simmer on low for 15-18 minutes until thick and jammy.",
                    "Let cool slightly and roughly chop to a spreadable consistency."
                  ]
                },
                {
                  "name": "Double Roasted Garlic Goat Cheese Spread",
                  "steps": [
                    "Mix 1 tbsp softened cream cheese and 1 tbsp softened goat cheese together until smooth.",
                    "Stir in 3 mashed roasted garlic cloves, 1 tsp grated Parmesan, 1/4 tsp fresh thyme leaves (minced), and a pinch of salt.",
                    "Mix until evenly combined."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter the potato bun and toast in a skillet until golden on both sides.",
                    "Spread Double Roasted Garlic Goat Cheese Spread on the bottom bun.",
                    "Add a thick layer of Roasted Garlic Mashed Potato Schmear on top.",
                    "Add a layer of Roasted Garlic Bacon Jam on top of the schmear.",
                    "Place the fried chicken on the bottom bun.",
                    "Top with fresh mozzarella, allowing it to melt from the heat.",
                    "Spoon Roasted Garlic Cream Sauce generously over the melted mozzarella.",
                    "Top with Roasted Garlic Parmesan Slaw, extra crispy garlic chips, and fresh thyme.",
                    "Place top bun and serve immediately."
                  ]
                }
              ],
              "id": "recipe-58",
              "number": 58,
              "title": "Roasted Garlic Cream Chicken Sandwich",
              "slug": "roasted-garlic-cream-chicken-sandwich",
              "chapterId": "chapter-7"
            },
            {
              "description": "Creamy marinara comfort on a bun — crushed tomatoes simmered with garlic, shallots, cream, and fresh basil get spooned over crispy fried chicken, creating a Caprese-inspired sandwich. Fresh mozzarella melts on top, while a sun-dried tomato basil bacon jam and sun-dried tomato basil goat cheese spread bring layered tomato complexity.",
