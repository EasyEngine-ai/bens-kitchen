        {
          "id": "chapter-11",
          "number": 11,
          "title": "UNIQUE CREATIONS",
          "recipeCount": 7,
          "recipes": [
            {
              "description": "A dazzling wet lemon pepper glazed fried chicken sandwich that combines bright citrus flavors with creamy, tangy cheese. Crispy fried chicken breast is tossed in a warm lemon pepper butter sauce and layered with a fresh feta and arugula slaw, pickled red onions, fried tomato slices, and candied pork belly. The roasted garlic and feta cream cheese spread adds a rich, savory foundation that perfectly balances the zesty citrus notes throughout this sophisticated yet indulgent creation.",
              "aboutSections": [
                {
                  "name": "Chicken & Batter",
                  "description": "A seasoned fried chicken breast with lemon pepper flavoring in the dry batter, ready to be tossed in the warm lemon pepper butter sauce for a wet, glossy finish."
                },
                {
                  "name": "Lemon Pepper Wet Sauce",
                  "description": "A bright, buttery sauce made from melted butter infused with fresh lemon juice, lemon pepper seasoning, and minced garlic. The sauce clings to the warm fried chicken, creating that signature wet appearance."
                },
                {
                  "name": "Lemon Pepper Slaw",
                  "description": "A refreshing slaw featuring shredded red cabbage and carrots tossed with crumbled feta cheese, fresh baby arugula, pickled red onions, and a lemon-forward dressing with bright citrus zest and a hint of sweetness."
                },
                {
                  "name": "Lemon Pepper Bacon Jam",
                  "description": "A sweet-savory-spicy jam made from rendered bacon with caramelized onions and garlic, finished with lemon juice and zest, brown sugar, and black pepper for depth. The lemon keeps it bright despite the rich bacon base."
                },
                {
                  "name": "Roasted Garlic Feta Cream Cheese Spread",
                  "description": "A creamy, tangy spread combining softened cream cheese with mashed roasted garlic cloves and crumbled feta cheese. No lemon in the spread itself—the garlic and feta provide rich, savory contrast to the citrus elements elsewhere."
                },
                {
                  "name": "Candied Pork Belly",
                  "description": "Thick-cut pork belly sliced and slow-roasted until crispy on the edges and tender inside, then glazed with a light sugar coating for a candied finish that adds richness and textural contrast."
                },
                {
                  "name": "Fried Tomato",
                  "description": "A fried tomato slice breaded and fried until golden, creating a warm, slightly crispy exterior with a soft, warm center."
                }
              ],
              "ingredientGroups": [
