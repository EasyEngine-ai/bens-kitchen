              "directionGroups": [
                {
                  "name": "Chicken & Batter",
                  "steps": [
                    "Pound the chicken breast to an even 3/4-inch thickness.",
                    "Toast white sesame seeds in a dry skillet over medium heat for 2-3 minutes until fragrant. Set aside.",
                    "In a shallow bowl, whisk together buttermilk and egg.",
                    "In another shallow bowl, combine all-purpose flour, potato starch, chicken bouillon powder, salt, and white pepper.",
                    "Heat beef tallow or lard to 350°F in a deep skillet or Dutch oven.",
                    "Dredge the chicken breast in the flour mixture, coating both sides evenly.",
                    "Dip the floured chicken into the wet batter, shaking off excess.",
                    "Press toasted sesame seeds onto both sides of the wet battered chicken.",
                    "Carefully place the chicken into the hot fat and fry for 6-8 minutes until golden brown and internal temperature reaches 165°F.",
                    "Remove chicken and drain on paper towels."
                  ]
                },
                {
                  "name": "Sesame-Soy Glaze",
                  "steps": [
                    "In a small bowl, whisk together sesame oil, soy sauce, rice vinegar, and minced garlic.",
                    "Stir in toasted sesame seeds.",
                    "Set aside until ready to use."
                  ]
                },
                {
                  "name": "Red Cabbage & Cucumber Slaw",
                  "steps": [
                    "In a medium bowl, combine shredded red cabbage, julienned cucumber, and sliced scallions.",
                    "In a small bowl, whisk together sesame oil, rice vinegar, sugar, and sesame salt.",
                    "Pour dressing over vegetables and toss to coat evenly.",
                    "Let sit for 5 minutes before serving to allow flavors to meld."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter the cut sides of a yellow potato or brioche bun and toast until golden.",
                    "Spread the Sesame-Ginger Cream Cheese Spread on the bottom bun.",
                    "Place the hot fried chicken breast on top.",
                    "Drizzle with Sesame-Soy Glaze.",
                    "Pile the Red Cabbage & Cucumber Slaw on the chicken.",
                    "Add a layer of pickled ginger slices.",
                    "Top with the bun and serve immediately."
                  ]
                }
              ],
              "id": "recipe-16",
              "number": 16,
              "title": "Sesame Chicken Sandwich",
              "slug": "sesame-chicken-sandwich",
              "chapterId": "chapter-3"
            },
            {
              "description": "This bold sandwich brings the mouth-numbing tingle of Szechuan peppercorns to fried chicken in an exciting way. Crispy fried chicken breast is glazed in a fiery red sauce made with chili oil, ginger, garlic, and Szechuan peppercorns that create an electrifying sensation. The heat is mellowed by a cool red cabbage and carrot slaw, while a spicy mayo and cilantro finish add fresh herbaceous notes that balance the intense spice.",
              "aboutSections": [
                {
                  "name": "Chicken & Batter",
                  "description": "A delicate batter with subtle hints of white pepper and garlic, creating a crispy golden crust that sets the stage for bold Szechuan flavors."
                },
                {
                  "name": "Szechuan Chili Glaze",
                  "description": "A fiery, fragrant sauce featuring chili oil, Szechuan peppercorns, ginger, garlic, and a touch of soy sauce for complex heat and numbness."
                },
                {
                  "name": "Red Cabbage & Carrot Slaw",
                  "description": "A cool, crunchy slaw of shredded red cabbage and carrots tossed in a light sesame vinaigrette to balance the heat."
                },
                {
                  "name": "Spicy Szechuan Mayo",
                  "description": "A creamy mayo infused with chili oil, minced garlic, Szechuan peppercorns, and fresh cilantro for a spicy cooling effect."
                },
                {
                  "name": "Szechuan Cream Cheese Spread",
                  "description": "A smooth spread of cream cheese mixed with chili oil and minced garlic for a peppery, numbing kick."
                }
              ],
