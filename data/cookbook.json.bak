              ],
              "directionGroups": [
                {
                  "name": "Jerk Dry Rub",
                  "steps": [
                    "Combine ground allspice, dried thyme, minced garlic, minced ginger, and salt in a small bowl.",
                    "Alternatively, use prepared jerk seasoning.",
                    "Rub evenly over the chicken breast, coating completely.",
                    "Let marinate for 15-30 minutes at room temperature."
                  ]
                },
                {
                  "name": "Chicken & Batter",
                  "steps": [
                    "Pat the jerk-seasoned chicken breast dry with paper towels.",
                    "Whisk together buttermilk, egg, and fresh lime juice in a shallow bowl.",
                    "In another shallow bowl, combine flour, potato starch, chicken bouillon powder, ground allspice, dried thyme, salt, and black pepper.",
                    "Dip chicken into wet batter, coat thoroughly, then dredge in dry batter, pressing gently to adhere. Let rest on a plate for 5 minutes.",
                    "Heat beef tallow or lard to 350°F in a heavy-bottomed pot or deep skillet, using a thermometer for accuracy.",
                    "Carefully place battered chicken into hot oil and fry for 6-7 minutes until golden brown and internal temperature reaches 165°F.",
                    "Drain on paper towels."
                  ]
                },
                {
                  "name": "Guava Glaze",
                  "steps": [
                    "In a small saucepan, combine guava paste or nectar, fresh lime juice, lime zest, minced habanero, and brown sugar.",
                    "Heat over medium heat, stirring constantly, until the guava paste melts and ingredients combine (about 3-4 minutes).",
                    "If using guava paste, thin with a tablespoon of water if too thick.",
                    "Remove from heat and let cool slightly before using."
                  ]
                },
                {
                  "name": "Tropical Guava Pineapple Slaw",
                  "steps": [
                    "In a medium bowl, toss shredded red cabbage, diced fresh pineapple, diced fresh mango, chopped cilantro, and pickled red onions together.",
                    "In a small bowl, whisk together lime juice, olive oil, honey, guava nectar or paste (2 tablespoons), salt, and black pepper.",
                    "Pour dressing over the slaw and toss to coat.",
                    "Refrigerate until ready to use."
                  ]
                },
                {
                  "name": "Guava Habanero Bacon Jam",
                  "steps": [
                    "In a small skillet, cook diced bacon over medium heat for 3-4 minutes until it begins to crisp and render fat.",
                    "Add diced onion and minced habanero, cooking for 2 minutes until softened.",
                    "Add diced fresh mango, guava paste or nectar (1/4 cup), brown sugar, and apple cider vinegar.",
                    "Reduce heat to medium-low and cook, stirring occasionally, for 10-12 minutes until the mixture becomes thick and jammy.",
                    "Season with salt. Remove from heat and let cool slightly."
                  ]
                },
                {
                  "name": "Jerk-Spiced Goat Cheese Spread",
                  "steps": [
                    "In a small bowl, combine softened cream cheese and fresh goat cheese. Mix until smooth.",
                    "Fold in jerk seasoning, fresh lime juice, garlic powder, and salt until well combined."
                  ]
                },
                {
                  "name": "Sweet Plantain Chips",
                  "steps": [
                    "Peel and slice ripe plantains into 1/4-inch thick rounds.",
                    "Heat beef tallow or lard to 325°F in a heavy-bottomed pot.",
                    "Fry plantain slices for 2-3 minutes per side until golden and crispy.",
                    "Drain on paper towels.",
                    "Sprinkle lightly with salt while still warm."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter and toast the bun lightly until golden, about 1-2 minutes per side.",
                    "Spread the jerk-spiced goat cheese spread on the bottom bun.",
                    "Spoon guava habanero bacon jam on top.",
                    "Place the guava glaze-coated chicken on the jam.",
                    "Pile the tropical guava pineapple slaw on the chicken.",
                    "Top with sweet plantain chips and pickled red onions.",
                    "Cap with the toasted top bun.",
                    "Serve immediately while the chicken is hot."
                  ]
                }
              ],
              "id": "recipe-44",
              "number": 44,
              "title": "Caribbean Jerk with Guava Chicken Sandwich - Sweet-Heat Tropical",
              "slug": "caribbean-jerk-with-guava-chicken-sandwich-sweet-heat-tropical",
              "chapterId": "chapter-6"
            },
            {
              "description": "A vibrant Peruvian-inspired masterpiece featuring a herbaceous green sauce made from fresh cilantro, mint, parsley, and pepitas that perfectly complements the crispy fried chicken. Layers of cool avocado, tangy pickled red onions, and fresh pisco-marinated vegetables add brightness and complexity. A green cilantro goat cheese spread anchors the sandwich on the bottom bun, while candied jalapeños and queso fresco finish it with sweet heat and creamy texture. Every bite delivers authentic South American verde essence and remarkable textural contrast.",
              "aboutSections": [
                {
                  "name": "Chicken & Batter",
                  "description": "A delicately seasoned fried crust with white pepper and garlic, providing a clean canvas for bold Peruvian herbaceous flavors."
                },
                {
                  "name": "Peruvian Green Sauce",
                  "description": "A vivid, complex sauce of fresh cilantro, mint, parsley, pepitas, sour cream, lime, and garlic—herbaceous, creamy, and quintessentially Peruvian."
                },
                {
                  "name": "Pickled Red Onion",
                  "description": "Thinly sliced red onions preserved in a tangy red wine vinegar and lime brine for sharp, acidic brightness."
                },
                {
                  "name": "Green Cilantro Goat Cheese Spread",
                  "description": "A creamy, herbaceous spread blending goat cheese and cream cheese with cilantro, green chiles, and lime."
                },
                {
                  "name": "Candied Jalapeños",
                  "description": "Sweet, glossy jalapeño rings suspended in a syrupy glaze for balanced sweet-heat contrast."
                },
                {
                  "name": "Aji Verde Sauce",
                  "description": "A creamy, spiced sauce that coats the chicken with rich, authentic flavor."
                },
                {
                  "name": "Peruvian Chopped Slaw",
                  "description": "A crunchy, bright slaw providing fresh contrast to the rich chicken."
                },
                {
                  "name": "Aji Amarillo Bacon Jam",
                  "description": "A sweet, spicy, and smoky jam adding depth and complexity to the sandwich."
                },
                {
                  "name": "Aji Verde Goat Cheese Spread",
                  "description": "A creamy, tangy spread using goat cheese for a savory foundation."
                }
              ],
