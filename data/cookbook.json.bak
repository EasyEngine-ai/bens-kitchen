              "directionGroups": [
                {
                  "name": "Chicken & Batter",
                  "steps": [
                    "Combine 1/2 cup buttermilk and 1 egg in a bowl and whisk until smooth. Set aside wet batter.",
                    "In another bowl, whisk together 1/4 cup all-purpose flour, 1/4 cup potato starch, 1 tsp chicken bouillon powder, 1/2 tsp granulated sugar, 1/4 tsp paprika, 1/2 tsp salt, and 1/4 tsp black pepper. Set aside dry batter.",
                    "Pat 6-8 oz chicken breasts dry with paper towels.",
                    "Dip chicken into wet batter, coating completely, then dredge in dry batter, shaking off excess.",
                    "Heat 2 cups beef tallow or lard to 350°F in a heavy-bottomed pot or Dutch oven.",
                    "Carefully place breaded chicken into hot fat and fry for 8-10 minutes until golden brown and internal temperature reaches 165°F.",
                    "Remove chicken and drain on paper towels."
                  ]
                },
                {
                  "name": "Blueberry Lavender Sauce",
                  "steps": [
                    "Heat 1 tbsp unsalted butter in a saucepan over medium heat.",
                    "Add 1 minced small shallot, cook 2 minutes until softened.",
                    "Add 1.25 cups fresh blueberries and cook 4-5 minutes until they burst and break down.",
                    "Pour in 1.5 tbsp balsamic vinegar and 1 tbsp honey, stir to combine.",
                    "Simmer 5-6 minutes until the sauce thickens to glossy consistency.",
                    "Stir in 1 tbsp fresh lemon juice, 1/2 tsp lemon zest, 1/4 tsp culinary lavender buds, 1/4 tsp fresh rosemary (minced), and a pinch of salt.",
                    "Remove from heat. Reserve 2 tbsp for slaw dressing."
                  ]
                },
                {
                  "name": "Crispy Bacon",
                  "steps": [
                    "Cook 3 slices bacon in a skillet over medium-high heat until very crispy.",
                    "Drain on paper towels."
                  ]
                },
                {
                  "name": "Blueberry Arugula Brie Slaw",
                  "steps": [
                    "Whisk together 2 tbsp blueberry lavender sauce, 1 tbsp mayonnaise, 1 tbsp fresh lemon juice, 1/2 tsp honey, and a pinch of salt for the dressing.",
                    "In a bowl, combine 1/2 cup fresh arugula, 2 tbsp fresh blueberries, 1 tbsp Brie cheese (diced small), 1 tbsp toasted sliced almonds, 1 tsp fresh mint (thinly sliced), and 1/4 tsp lemon zest.",
                    "Pour dressing over and toss gently to coat.",
                    "Refrigerate until ready to serve."
                  ]
                },
                {
                  "name": "Blueberry Lavender Bacon Jam",
                  "steps": [
                    "Cook 4 slices diced thick-cut bacon in a skillet over medium heat until crispy, about 6-7 minutes.",
                    "Drain most fat, leaving about 1 tbsp.",
                    "Add 1 minced shallot, cook 2 minutes.",
                    "Add 1/4 cup fresh blueberries, cook 2-3 minutes until they burst and break down.",
                    "Add a tiny pinch of culinary dried lavender buds, 1 tsp honey, 1 tbsp brown sugar, 1 tbsp balsamic vinegar, 1 tsp fresh lemon juice, and 2 tbsp water.",
                    "Simmer on low for 15-18 minutes until thick and jammy.",
                    "Let cool and roughly chop to spreadable consistency."
                  ]
                },
                {
                  "name": "Lavender Honey Brie Goat Cheese Spread",
                  "steps": [
                    "Mix 1 tbsp softened cream cheese, 1 tbsp softened goat cheese, and 1 tbsp softened Brie (rind removed) until smooth.",
                    "Stir in 1/2 tsp honey, a tiny pinch of crushed culinary lavender buds, 1/4 tsp lemon zest, and a pinch of salt.",
                    "Mix until evenly combined."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter the potato bun and toast in a skillet until golden on both sides.",
                    "Spread Lavender Honey Brie Goat Cheese Spread on the bottom bun.",
                    "Add a layer of Blueberry Lavender Bacon Jam on top of the spread.",
                    "Place the fried chicken on the bottom bun.",
                    "Top with Brie slices, allowing them to get creamy from the heat.",
                    "Layer crispy bacon over the Brie.",
                    "Spoon Blueberry Lavender Sauce generously over everything.",
                    "Top with Blueberry Arugula Brie Slaw, extra toasted almonds, and fresh mint.",
                    "Place top bun and serve immediately."
                  ]
                }
              ],
