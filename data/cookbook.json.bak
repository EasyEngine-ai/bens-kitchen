            {
              "usedIn": [
                "Hot Honey Chicken Sandwich"
              ],
              "description": "A silky blend of softened butter whipped with honey and a pinch of salt. Spread on the warm bun for richness and subtle sweetness that pairs beautifully with the heat of hot honey.",
              "ingredients": [
                {
                  "item": "unsalted butter, softened",
                  "amount": "2 tablespoons"
                },
                {
                  "item": "honey",
                  "amount": "1/2 tablespoon"
                },
                {
                  "item": "sea salt flakes",
                  "amount": "1/4 teaspoon"
                }
              ],
              "directions": [
                "In a small bowl, combine softened butter and honey.",
                "Whip together with a fork until light and fluffy, about 1-2 minutes.",
                "Season with a pinch of salt.",
                "Spread on the toasted bun halves immediately before assembly."
              ],
