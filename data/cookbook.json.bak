              "directionGroups": [
                {
                  "name": "Chicken & Batter",
                  "steps": [
                    "Pat chicken breast dry with paper towels.",
                    "In a shallow bowl, whisk together buttermilk, egg, and fresh lime juice.",
                    "In another shallow bowl, whisk together flour, potato starch, chicken bouillon powder, madras curry powder, ground allspice, salt, and black pepper.",
                    "Dip chicken into wet batter, coating completely, then dredge in dry batter mixture, shaking off excess.",
                    "Heat beef tallow or lard to 350°F in a heavy-bottomed pot or Dutch oven.",
                    "Carefully place breaded chicken into hot fat and fry for 8-10 minutes until golden brown and internal temperature reaches 165°F.",
                    "Remove and drain on paper towels."
                  ]
                },
                {
                  "name": "Caribbean Curry Sauce",
                  "steps": [
                    "Heat olive oil in a saucepan over medium heat.",
                    "Sauté diced onion and minced garlic for 2 minutes until fragrant.",
                    "Add madras curry powder and cook for 1 minute, stirring constantly.",
                    "Add grated fresh ginger, dried thyme, ground allspice, and diced tomato, cook 1 minute.",
                    "Pour in coconut milk and vegetable broth, add whole Scotch bonnet (do not pierce).",
                    "Stir in fresh lime juice.",
                    "Simmer 10 minutes until thickened.",
                    "Remove Scotch bonnet before serving.",
                    "Season with salt and black pepper."
                  ]
                },
                {
                  "name": "Caribbean Curry Slaw",
                  "steps": [
                    "In a small bowl, whisk together mayonnaise, curry powder, fresh lime juice, honey, and salt.",
                    "In a larger bowl, toss shredded green and red cabbage, diced fresh mango, diced fresh pineapple, shredded carrots, chopped cilantro, and pickled red onions together.",
                    "Pour dressing over slaw and toss to coat.",
                    "Refrigerate until ready to serve."
                  ]
                },
                {
                  "name": "Mango Curry Bacon Jam",
                  "steps": [
                    "Cook diced bacon in a skillet over medium heat until crispy, about 6-7 minutes.",
                    "Drain most of the fat, leaving about 1 tablespoon.",
                    "Add diced yellow onion and cook 2 minutes.",
                    "Add diced fresh mango, madras curry powder, ground allspice, brown sugar, apple cider vinegar, Scotch bonnet hot sauce, and water.",
                    "Simmer on low for 15-18 minutes, stirring occasionally, until thick and jammy.",
                    "Let cool slightly and roughly chop to a spreadable consistency."
                  ]
                },
                {
                  "name": "Curry-Spiced Goat Cheese Spread",
                  "steps": [
                    "Mix softened cream cheese and softened goat cheese together until smooth.",
                    "Stir in madras curry powder, ground turmeric, honey, salt, and crushed pork rinds until evenly combined."
                  ]
                },
                {
                  "name": "Candied Jalapeños",
                  "steps": [
                    "Combine granulated sugar, water, and apple cider vinegar in a small saucepan over medium heat.",
                    "Stir until sugar dissolves.",
                    "Add sliced jalapeño rings and simmer for 8-10 minutes until jalapeños are glazed and syrup is thick.",
                    "Remove from heat and let cool."
                  ]
                },
                {
                  "name": "Crispy Fried Shallots",
                  "steps": [
                    "Thinly slice shallots.",
                    "Heat 1/2 cup beef tallow or lard to 325°F.",
                    "Fry shallot slices for 2-3 minutes until golden.",
                    "Drain on paper towels."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter the potato bun and toast in a skillet until golden on both sides.",
                    "Spread Curry-Spiced Goat Cheese Spread on the bottom bun.",
                    "Add a layer of Mango Curry Bacon Jam on top of the spread.",
                    "Place the fried chicken on the bottom bun.",
                    "Spoon Caribbean Curry Sauce generously over the chicken.",
                    "Top with Caribbean Curry Slaw, mango chutney, pickled red onions, and candied jalapeños.",
                    "Garnish with fresh cilantro and crispy fried shallots.",
                    "Place top bun and serve immediately while the chicken is hot."
                  ]
                }
              ],
              "id": "recipe-43",
              "number": 43,
              "title": "Caribbean Curry Chicken Sandwich",
              "slug": "caribbean-curry-chicken-sandwich",
              "chapterId": "chapter-6"
            },
            {
              "description": "A sweet-heat tropical fusion of Caribbean jerk and island fruit. Crispy fried chicken is marinated in traditional jerk spices and glazed with a guava reduction, then layered with tropical pineapple slaw and a guava habanero bacon jam. Fresh cilantro and lime brighten this bold, complex sandwich.",
              "aboutSections": [
                {
                  "name": "Chicken & Batter",
                  "description": "Fried chicken seasoned with allspice and thyme, providing a warm spice foundation for sweet-heat guava glaze."
                },
                {
                  "name": "Jerk Dry Rub",
                  "description": "A bold blend of allspice, thyme, scotch bonnet, garlic, ginger, soy sauce, and brown sugar creating authentic Caribbean jerk seasoning."
                },
                {
                  "name": "Guava Glaze",
                  "description": "A sweet-tangy glaze of guava paste or nectar balanced with lime, habanero heat, and brown sugar."
                },
                {
                  "name": "Tropical Guava Pineapple Slaw",
                  "description": "A bright slaw of shredded red cabbage, fresh pineapple, mango, cilantro, and pickled red onions dressed in a guava-lime vinaigrette."
                },
                {
                  "name": "Guava Habanero Bacon Jam",
                  "description": "A sophisticated sweet-heat jam combining crispy bacon, fresh guava, mango, habanero, and brown sugar."
                },
                {
                  "name": "Jerk-Spiced Goat Cheese Spread",
                  "description": "A creamy spread of goat cheese and cream cheese infused with jerk seasoning and lime for warm, savory island flavor."
                },
                {
                  "name": "Jerk Marinade",
                  "description": "A key component that complements the chicken and sauce."
                },
                {
                  "name": "Sweet Plantain Chips",
                  "description": "A key component that complements the chicken and sauce."
                },
                {
