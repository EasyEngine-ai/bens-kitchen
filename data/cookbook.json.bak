            {
              "usedIn": [
                "Loaded Baked Potato Chicken Sandwich"
              ],
              "description": "A large russet potato baked until fluffy inside and crispy-skinned outside, then split open and filled with butter, sour cream, sharp cheddar cheese, crispy bacon crumbles, white onions, and chives. The chicken sits directly on top.",
              "ingredients": [
                {
                  "item": "large russet potato",
                  "amount": "1"
                },
                {
                  "item": "unsalted butter",
                  "amount": "2.5 tbsp"
                },
                {
                  "item": "sour cream",
                  "amount": "3 tbsp"
                },
                {
                  "item": "sharp cheddar cheese, shredded",
                  "amount": "1/3 cup"
                },
                {
                  "item": "crispy bacon crumbles",
                  "amount": "3 tbsp"
                },
                {
                  "item": "white onions, diced",
                  "amount": "3 tbsp"
                },
                {
                  "item": "fresh chives, chopped",
                  "amount": "1.5 tbsp"
                },
                {
                  "item": "salt",
                  "amount": "to taste"
                },
                {
                  "item": "black pepper",
                  "amount": "to taste"
                }
              ],
              "directions": [
                "Preheat oven to 400°F.",
                "Scrub the russet potato under running water and pat dry.",
                "Poke holes all over the potato with a fork.",
                "Place directly on the oven rack and bake for 50-60 minutes until a fork pierces the flesh easily.",
                "Remove from oven and let cool slightly for 2-3 minutes.",
                "Cut the potato in half lengthwise.",
