                  ]
                },
                {
                  "name": "Sun-Dried Tomato Pesto",
                  "steps": [
                    "In a food processor, combine drained sun-dried tomatoes, fresh basil leaves, pine nuts, grated Parmesan, and minced garlic.",
                    "Pulse until coarsely combined.",
                    "With the processor running, slowly drizzle in extra virgin olive oil until the pesto reaches your desired consistency.",
                    "Add lemon juice, mayonnaise, and red pepper flakes.",
                    "Season with salt and black pepper. Set aside."
                  ]
                },
                {
                  "name": "Italian Arugula Slaw",
