              "directionGroups": [
                {
                  "name": "Chicken & Batter",
                  "steps": [
                    "Pound the chicken breast to an even 3/4-inch thickness.",
                    "In a shallow bowl, whisk together buttermilk, egg, and 1 tablespoon Frank's RedHot sauce.",
                    "In another shallow bowl, combine flour, potato starch, chicken bouillon powder, paprika, garlic powder, onion powder, cayenne, salt, and black pepper.",
                    "Submerge the chicken in the wet batter for at least 15 minutes (or up to 4 hours in the fridge).",
                    "Heat beef tallow or lard to 350°F in a deep pot or cast iron skillet.",
                    "Remove chicken from wet batter, letting excess drip off. Dredge thoroughly in the dry batter, pressing to adhere. For extra crunch, dip back in wet batter and dredge again.",
                    "Fry for 6-8 minutes, flipping halfway, until golden brown and internal temperature reaches 165°F.",
                    "Rest on a wire rack for 2 minutes, then toss in buffalo sauce."
                  ]
                },
                {
                  "name": "Buffalo Sauce",
                  "steps": [
                    "In a small saucepan over medium-low heat, melt the butter.",
                    "Add Frank's RedHot sauce, Worcestershire sauce, and garlic powder.",
                    "Whisk until combined and warmed through, about 2 minutes.",
                    "Remove from heat. Toss the fried chicken in the sauce to coat."
                  ]
                },
                {
                  "name": "Chunky Blue Cheese Dressing",
                  "steps": [
                    "In a small bowl, whisk together mayonnaise and sour cream until smooth.",
                    "Stir in crumbled Gorgonzola or Roquefort cheese, breaking it into large chunks.",
                    "Add fresh lemon juice, Worcestershire sauce, and garlic powder.",
                    "Season with salt and pepper. Refrigerate until ready to use."
                  ]
                },
                {
                  "name": "Buffalo Blue Cheese Slaw",
                  "steps": [
                    "In a large bowl, combine shredded cabbage, carrots, celery, and red onions.",
                    "In a small bowl, whisk together mayonnaise, Frank's RedHot, sugar, apple cider vinegar, and celery seed.",
                    "Pour the dressing over the vegetables and toss to coat evenly.",
                    "Fold in blue cheese crumbles gently.",
                    "Season with salt and pepper. Refrigerate for at least 15 minutes before serving."
                  ]
                },
                {
                  "name": "Buffalo Bacon Jam",
                  "steps": [
                    "In a skillet over medium heat, cook the diced bacon until crispy, about 6-8 minutes.",
                    "Remove half the bacon fat, leaving about 1 tablespoon in the pan.",
                    "Add diced onion and cook until softened, about 4 minutes.",
                    "Add minced garlic and cook for 1 minute.",
                    "Stir in Frank's RedHot sauce, brown sugar, and apple cider vinegar.",
                    "Reduce heat to low and simmer for 8-10 minutes, stirring occasionally, until thick and jammy.",
                    "Season with salt. Let cool slightly — it will thicken as it cools."
                  ]
                },
                {
                  "name": "Blue Cheese Cream Cheese Goat Cheese Spread",
                  "steps": [
                    "In a small bowl, combine softened cream cheese, fresh goat cheese, and crumbled blue cheese.",
                    "Mix until smooth and well blended, about 1-2 minutes.",
                    "Stir in minced garlic.",
                    "Season with salt and pepper. Spread on the bottom bun before assembling."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter both halves of the bun and toast on a griddle or skillet until golden, about 2 minutes.",
                    "Spread Blue Cheese Cream Cheese Goat Cheese Spread on the bottom bun.",
                    "Spoon a generous layer of Buffalo Bacon Jam on top of the spread.",
                    "Place the buffalo sauce-tossed chicken on top.",
                    "Drizzle Chunky Blue Cheese Dressing over the chicken.",
                    "Pile on Buffalo Blue Cheese Slaw.",
                    "Add crispy fried onion strings.",
                    "Place the top bun and serve immediately."
                  ]
                }
              ],
              "id": "recipe-3",
              "number": 3,
              "title": "Buffalo Blue Cheese Chicken Sandwich",
              "slug": "buffalo-blue-cheese-chicken-sandwich",
              "chapterId": "chapter-1"
            },
            {
              "description": "The viral Sunkist wings recipe reimagined as a chicken sandwich. Crispy fried chicken is tossed in a tangy-spicy sauce made from reduced Sunkist orange soda, Frank's RedHot, and butter. Bright citrus slaw with orange zest and a sweet-spicy orange-infused bacon jam provide fruity undertones. Finished with a goat cheese spread and candied orange peel for a surprising, craveable flavor combination.",
              "aboutSections": [
                {
                  "name": "Sunkist Buffalo Sauce",
                  "description": "A unique blend of reduced Sunkist orange soda combined with Frank's RedHot and butter. The citrus sweetness balances the heat, creating a tangy-spicy sauce with fruity notes."
                },
                {
                  "name": "Citrus Slaw",
                  "description": "A bright, fresh slaw with shredded cabbage, carrots, and red onions, tossed in a mayo-based dressing with orange zest, fresh orange juice, and a hint of Frank's RedHot for balanced citrus-spicy flavor."
                },
                {
                  "name": "Sunkist Buffalo Bacon Jam",
                  "description": "A sweet-spicy jam combining bacon, onions, and garlic simmered with Frank's RedHot, brown sugar, and orange juice for fruity depth. The citrus complements the smokiness and heat."
                },
                {
                  "name": "Sunkist Buffalo Goat Cheese Spread",
                  "description": "A creamy spread of softened cream cheese and tangy goat cheese blended with Frank's RedHot and orange zest. Spread on the bottom bun for a citrus-forward, savory base."
                }
              ],
