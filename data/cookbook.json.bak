              "directionGroups": [
                {
                  "name": "Chicken & Batter",
                  "steps": [
                    "Combine 1/2 cup buttermilk and 1 egg in a bowl and whisk until smooth. Set aside wet batter.",
                    "In another bowl, whisk together 1/4 cup all-purpose flour, 1/4 cup potato starch, 1 tsp chicken bouillon powder, 1/2 tsp dried basil, 1/4 tsp garlic powder, 1/2 tsp salt, and 1/4 tsp black pepper. Set aside dry batter.",
                    "Pat 6-8 oz chicken breasts dry with paper towels.",
                    "Dip chicken into wet batter, coating completely, then dredge in dry batter, shaking off excess.",
                    "Heat 2 cups beef tallow or lard to 350°F in a heavy-bottomed pot or Dutch oven.",
                    "Carefully place breaded chicken into hot fat and fry for 8-10 minutes until golden brown and internal temperature reaches 165°F.",
                    "Remove chicken and drain on paper towels."
                  ]
                },
                {
                  "name": "Roasted Red Pepper Cream Sauce",
                  "steps": [
                    "Heat 2 tbsp unsalted butter in a saucepan over medium heat.",
                    "Add 2 minced garlic cloves, cook 1 minute.",
                    "Add 3/4 cup roasted red peppers (jarred or fresh), cook 2 minutes.",
                    "Pour in 1/2 cup cream and 1/4 cup vegetable broth, simmer 3 minutes.",
                    "Remove from heat and blend until smooth with an immersion blender (or transfer to blender).",
                    "Return to saucepan and stir in 2 tbsp fresh basil (minced) and 1/2 tsp balsamic vinegar.",
                    "Season with 1/4 tsp salt and 1/8 tsp black pepper.",
                    "Keep warm and reserve 2 tbsp for slaw dressing."
                  ]
                },
                {
                  "name": "Roasted Red Pepper Basil Slaw",
                  "steps": [
                    "Whisk together 2 tbsp red pepper cream sauce, 1 tbsp mayonnaise, 1/2 tsp balsamic vinegar, 1 tsp fresh lemon juice, and a pinch of salt for the dressing.",
                    "In a bowl, toss 1/2 cup shredded red cabbage, 1/4 cup fresh arugula, 2 tbsp diced roasted red peppers, 2 tbsp diced fresh mozzarella, 1 tbsp toasted pine nuts, and 1 tbsp fresh basil (thinly sliced).",
                    "Pour dressing over and toss to coat.",
                    "Refrigerate until ready to serve."
                  ]
                },
                {
                  "name": "Roasted Red Pepper Bacon Jam",
                  "steps": [
                    "Cook 4 slices diced thick-cut bacon in a skillet over medium heat until crispy, about 6-7 minutes.",
                    "Drain most fat, leaving about 1 tbsp in the pan.",
                    "Add 2 tbsp diced yellow onion and 1 minced garlic clove, cook 2 minutes.",
                    "Add 1/4 cup diced roasted red peppers and 1 tsp fresh basil (minced).",
                    "Add 1/4 tsp smoked paprika, 1 tbsp brown sugar, 1 tbsp balsamic vinegar, and 2 tbsp water.",
                    "Simmer on low for 15-18 minutes until thick and jammy.",
                    "Let cool slightly and roughly chop to a spreadable consistency."
                  ]
                },
                {
                  "name": "Roasted Red Pepper Goat Cheese Spread",
                  "steps": [
                    "Mix 1 tbsp softened cream cheese and 1 tbsp softened goat cheese together until smooth.",
                    "Stir in 1 tbsp finely minced roasted red pepper, 1 mashed roasted garlic clove, 1/2 tsp fresh basil (finely minced), and a pinch of salt.",
                    "Mix until evenly combined."
                  ]
                },
                {
                  "name": "Toasted Pine Nuts",
                  "steps": [
                    "Toast 1 tbsp pine nuts in a dry skillet over medium heat for 2-3 minutes, shaking frequently, until golden.",
                    "Set aside to cool."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter the potato bun and toast in a skillet until golden on both sides.",
                    "Spread Roasted Red Pepper Goat Cheese Spread on the bottom bun.",
                    "Add a layer of Roasted Red Pepper Bacon Jam on top of the spread.",
                    "Place the fried chicken on the bottom bun.",
                    "Layer roasted red pepper strips over the chicken.",
                    "Spoon Roasted Red Pepper Cream Sauce generously over everything.",
                    "Top with Roasted Red Pepper Basil Slaw, extra toasted pine nuts, and fresh basil.",
                    "Place top bun and serve immediately."
                  ]
                }
              ],
