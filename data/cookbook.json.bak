              "directionGroups": [
                {
                  "name": "Chicken & Batter",
                  "steps": [
                    "Pat chicken breast dry with paper towels.",
                    "Whisk together buttermilk, egg, and fresh lime juice in a shallow bowl.",
                    "In another shallow bowl, combine flour, potato starch, chicken bouillon powder, ground cumin, smoked paprika, garlic powder, salt, and black pepper.",
                    "Dip chicken into wet batter, coat thoroughly, then dredge in dry batter, pressing gently to adhere. Let rest on a plate for 5 minutes.",
                    "Heat beef tallow or lard to 350°F in a heavy-bottomed pot or deep skillet, using a thermometer for accuracy.",
                    "Carefully place battered chicken into hot oil and fry for 6-7 minutes until golden brown and internal temperature reaches 165°F.",
                    "Drain on paper towels."
                  ]
                },
                {
                  "name": "Corn and Poblano Sauce",
                  "steps": [
                    "In a saucepan, heat olive oil over medium heat.",
                    "Sauté fresh corn kernels (1/2 cup) for 2-3 minutes until lightly charred.",
                    "Add sliced roasted poblano pepper (1/2 pepper), minced garlic (1 clove), and cook for 1 minute.",
                    "Add masa harina (3 tablespoons) mixed with vegetable broth (1/2 cup) to create a smooth paste.",
                    "Stir constantly to avoid lumps.",
                    "Add shredded sharp cheddar (1/4 cup), Mexican crema (2 tablespoons), and salt to taste.",
                    "Simmer for 5-7 minutes until thickened and creamy.",
                    "Season with salt and white pepper."
                  ]
                },
                {
                  "name": "Cornbread Crumb Topping",
                  "steps": [
                    "Crumble cooked cornbread into fine crumbs (about 1/4 cup).",
                    "Heat 1 tablespoon butter in a skillet over medium heat.",
                    "Toast the cornbread crumbs for 2-3 minutes, stirring frequently, until golden and fragrant.",
                    "Season lightly with salt."
                  ]
                },
                {
                  "name": "Corn and Cheese Spread",
                  "steps": [
                    "In a small bowl, combine softened cream cheese and shredded sharp cheddar. Mix until smooth.",
                    "Fold in roasted corn kernels (2 tablespoons), diced roasted poblano pepper (2 tablespoons), garlic powder, and salt until well combined."
                  ]
                },
                {
                  "name": "Pickled Red Onion",
                  "steps": [
                    "Thinly slice red onion and place in a small bowl.",
                    "Pour red wine vinegar, fresh lime juice, and salt over the onions.",
                    "Toss to combine.",
                    "Let sit at room temperature for 15 minutes before serving."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter and toast the bun lightly until golden, about 1-2 minutes per side.",
                    "Spread the corn and cheese spread on the bottom bun.",
                    "Place the corn and poblano sauce-coated chicken on top.",
                    "Top with pickled red onions, roasted poblano slices, crumbled cotija cheese, fresh cilantro, and sliced avocado.",
                    "Sprinkle the cornbread crumb topping over the top.",
                    "Cap with the toasted top bun.",
                    "Serve immediately while the chicken is hot."
                  ]
                }
              ],
