              ],
              "description": "A silky, luxurious sauce made with brandy-infused shallots, fresh cream, and brined green peppercorns for a sophisticated, peppery depth with subtle brandy notes.",
              "ingredients": [
                {
                  "item": "unsalted butter",
                  "amount": "2 tbsp"
                },
                {
                  "item": "shallots (minced)",
                  "amount": "2 shallots"
                },
                {
                  "item": "green peppercorns packed in brine (drained)",
                  "amount": "2 tbsp"
                },
                {
                  "item": "brandy or cognac",
                  "amount": "2 tbsp"
                },
                {
                  "item": "heavy cream",
                  "amount": "3/4 cup"
                },
                {
                  "item": "beef broth",
                  "amount": "2 tbsp"
                },
