              "directionGroups": [
                {
                  "name": "Chicken & Batter",
                  "steps": [
                    "Combine 1/2 cup buttermilk and 1 egg in a bowl and whisk until smooth. Set aside wet batter.",
                    "In another bowl, whisk together 1/4 cup all-purpose flour, 1/4 cup potato starch, 1 tsp chicken bouillon powder, 1/2 tsp dried basil, 1/4 tsp garlic powder, 1/2 tsp salt, and 1/4 tsp black pepper. Set aside dry batter.",
                    "Pat 6-8 oz chicken breasts dry with paper towels.",
                    "Dip chicken into wet batter, coating completely, then dredge in dry batter, shaking off excess.",
                    "Heat 2 cups beef tallow or lard to 350°F in a heavy-bottomed pot or Dutch oven.",
                    "Carefully place breaded chicken into hot fat and fry for 8-10 minutes until golden brown and internal temperature reaches 165°F.",
                    "Remove chicken and drain on paper towels."
                  ]
                },
                {
                  "name": "Tomato Cream Sauce",
                  "steps": [
                    "Heat 1 tbsp extra virgin olive oil in a saucepan over medium heat.",
                    "Add 1 minced shallot, cook 1 minute.",
                    "Add 2 minced garlic cloves, cook 30 seconds.",
                    "Pour in 3/4 cup crushed canned tomatoes and 1/2 tsp dried oregano, simmer 5 minutes until tomatoes break down.",
                    "Add 1/2 cup heavy cream in a steady stream while whisking.",
                    "Bring to gentle simmer, cook 2 minutes.",
                    "Remove from heat and stir in 3 tbsp fresh basil (minced), 1/2 tsp balsamic vinegar, and 1/4 tsp sugar.",
                    "Season with 1/4 tsp salt and 1/8 tsp black pepper.",
                    "Keep warm and reserve 2 tbsp for slaw dressing."
                  ]
                },
                {
                  "name": "Tomato Basil Caprese Slaw",
                  "steps": [
                    "Whisk together 2 tbsp tomato cream sauce, 1 tbsp mayonnaise, 1/2 tsp balsamic vinegar, 1 tsp fresh lemon juice, a pinch of dried oregano, and a pinch of salt for the dressing.",
                    "In a bowl, combine 1/2 cup shredded romaine, 1/4 cup halved cherry tomatoes, 2 tbsp diced fresh mozzarella, 1 tbsp fresh basil (thinly sliced), 1 tbsp diced roasted red peppers, 2 sliced roasted garlic cloves, and 2 tbsp pickled red onions.",
                    "Pour dressing over and toss gently to coat.",
                    "Refrigerate until ready to serve."
                  ]
                },
                {
                  "name": "Tomato Basil Bacon Jam",
                  "steps": [
                    "Cook 4 slices diced thick-cut bacon in a skillet over medium heat until crispy, about 6-7 minutes.",
                    "Drain most fat, leaving about 1 tbsp in the pan.",
                    "Add 2 tbsp diced yellow onion and 1 minced garlic clove, cook 2 minutes.",
                    "Add 2 tbsp crushed canned tomatoes, 1 tbsp minced sun-dried tomatoes, 1 tsp fresh basil (minced), and 1/4 tsp dried oregano.",
                    "Add 1 tbsp brown sugar, 1 tbsp balsamic vinegar, and 2 tbsp water.",
                    "Simmer on low for 15-18 minutes until thick and jammy.",
                    "Let cool slightly and roughly chop to a spreadable consistency."
                  ]
                },
                {
                  "name": "Sun-Dried Tomato Basil Goat Cheese Spread",
                  "steps": [
                    "Mix 1 tbsp softened cream cheese and 1 tbsp softened goat cheese together until smooth.",
                    "Stir in 1 tbsp finely minced sun-dried tomatoes, 1 tsp fresh basil (finely minced), 1 mashed roasted garlic clove, 1/4 tsp dried oregano, and a pinch of salt.",
                    "Mix until evenly combined."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter the potato bun and toast in a skillet until golden on both sides.",
                    "Spread Sun-Dried Tomato Basil Goat Cheese Spread on the bottom bun.",
                    "Add a layer of Tomato Basil Bacon Jam on top of the spread.",
                    "Place the fried chicken on the bottom bun.",
                    "Top with fresh mozzarella slices, allowing them to melt from the heat.",
                    "Spoon Tomato Cream Sauce generously over the melted mozzarella.",
                    "Top with Tomato Basil Caprese Slaw and fresh basil leaves.",
                    "Place top bun and serve immediately."
                  ]
                }
              ],
