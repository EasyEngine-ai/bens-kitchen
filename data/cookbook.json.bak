                      "item": "Brandy Peppercorn Bacon Jam",
                      "amount": ""
                    },
                    {
                      "item": "Peppercorn Goat Cheese Spread (spread on bottom bun)",
                      "amount": ""
                    },
                    {
                      "item": "Green Peppercorn Cream Sauce (spooned over chicken)",
                      "amount": ""
                    },
                    {
                      "item": "Sautéed leeks (layered on chicken)",
                      "amount": ""
                    },
                    {
                      "item": "Gruyère cheese (melted over chicken)",
