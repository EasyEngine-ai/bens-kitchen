              "directionGroups": [
                {
                  "name": "Chicken & Batter",
                  "steps": [
                    "Combine 1/2 cup buttermilk and 1 egg in a bowl and whisk until smooth. Set aside wet batter.",
                    "In another bowl, whisk together 1/4 cup all-purpose flour, 1/4 cup potato starch, 1 tsp chicken bouillon powder, 1/2 tsp dried parsley, 1/2 tsp salt, and 1/4 tsp white pepper. Set aside dry batter.",
                    "Pat 6-8 oz chicken breasts dry with paper towels.",
                    "Dip chicken into wet batter, coating completely, then dredge in dry batter, shaking off excess.",
                    "Heat 2 cups beef tallow or lard to 350°F in a heavy-bottomed pot or Dutch oven.",
                    "Carefully place breaded chicken into hot fat and fry for 8-10 minutes until golden brown and internal temperature reaches 165°F.",
                    "Remove chicken and drain on paper towels."
                  ]
                },
                {
                  "name": "Alfredo Sauce",
                  "steps": [
                    "Heat 3 tbsp unsalted butter in a saucepan over medium-low heat.",
                    "Add 3 minced garlic cloves and cook 1-2 minutes until fragrant.",
                    "Slowly add 3/4 cup heavy cream while whisking constantly.",
                    "Bring to gentle simmer, cook 2 minutes.",
                    "Remove from heat and whisk in 1/2 cup grated Parmesan cheese until smooth and creamy.",
                    "Stir in 1/2 tsp fresh lemon juice.",
                    "Season with 1/4 tsp salt and 1/8 tsp white pepper.",
                    "Keep warm and reserve 2 tbsp for slaw dressing."
                  ]
                },
                {
                  "name": "Sautéed Wild Mushrooms",
                  "steps": [
                    "Chop 1.5 cups mixed wild mushrooms (cremini, shiitake, oyster) into bite-sized pieces.",
                    "Heat 1.5 tbsp unsalted butter in a skillet over medium-high heat.",
                    "Add 1 minced shallot, cook 1 minute.",
                    "Add mushrooms and cook 3-4 minutes until they release moisture.",
                    "Add 2 minced garlic cloves and 2 fresh thyme sprigs, cook 2-3 minutes until golden.",
                    "Pour in 2 tbsp dry white wine and simmer 1 minute.",
                    "Season with 1/4 tsp salt and 1/8 tsp black pepper.",
                    "Discard thyme sprigs and set aside. Reserve 1 tbsp finely minced for goat cheese spread."
                  ]
                },
                {
                  "name": "Mushroom Parmesan Slaw",
                  "steps": [
                    "Whisk together 2 tbsp Alfredo sauce, 1 tbsp mayonnaise, 1 tbsp fresh lemon juice, 1/2 tsp Dijon mustard, and a pinch of salt for the dressing.",
                    "In a bowl, combine 1/2 cup shredded red cabbage, 1/4 cup thinly sliced raw cremini mushrooms, 2 tbsp shaved Parmesan cheese, 1 tbsp fresh parsley (chopped), and 1/2 tsp fresh thyme leaves.",
                    "Pour dressing over and toss to coat evenly.",
                    "Refrigerate until ready to serve."
                  ]
                },
                {
                  "name": "Mushroom Bacon Jam",
                  "steps": [
                    "Cook 4 slices diced thick-cut bacon in a skillet over medium heat until crispy, about 6-7 minutes.",
                    "Drain most fat, leaving about 1 tbsp in the pan.",
                    "Add 1 minced shallot and 1 minced garlic clove, cook 2 minutes.",
                    "Add 1/2 cup finely diced cremini mushrooms and cook 3-4 minutes until browned.",
                    "Add 1/2 tsp fresh thyme leaves.",
                    "Deglaze with 1 tbsp dry white wine, simmer 30 seconds.",
                    "Add 1 tbsp brown sugar, 1 tbsp balsamic vinegar, and 2 tbsp water.",
                    "Simmer on low for 15-18 minutes until thick and jammy.",
                    "Let cool slightly and roughly chop to a spreadable consistency."
                  ]
                },
                {
                  "name": "Roasted Garlic Mushroom Goat Cheese Spread",
                  "steps": [
                    "Mix 1 tbsp softened cream cheese and 1 tbsp softened goat cheese together until smooth.",
                    "Stir in 2 mashed roasted garlic cloves, 1 tbsp finely minced sautéed mushrooms, 1/4 tsp fresh thyme leaves, and a pinch of salt.",
                    "Mix until evenly combined."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter the potato bun and toast in a skillet until golden on both sides.",
                    "Spread Roasted Garlic Mushroom Goat Cheese Spread on the bottom bun.",
                    "Add a layer of Mushroom Bacon Jam on top of the spread.",
                    "Place the fried chicken on the bottom bun.",
                    "Layer sautéed wild mushrooms over the chicken.",
                    "Top with 2 slices of Swiss cheese, allowing it to melt from the heat.",
                    "Spoon Alfredo Sauce generously over the cheese and mushrooms.",
                    "Top with Mushroom Parmesan Slaw and fresh thyme.",
                    "Place top bun and serve immediately."
                  ]
                }
              ],
