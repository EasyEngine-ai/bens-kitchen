              "directionGroups": [
                {
                  "name": "Chicken & Batter",
                  "steps": [
                    "Combine 1/2 cup buttermilk and 1 egg in a bowl and whisk until smooth. Set aside wet batter.",
                    "In another bowl, whisk together 1/4 cup all-purpose flour, 1/4 cup potato starch, 1 tsp chicken bouillon powder, 1/2 tsp dried sage, 1/2 tsp salt, and 1/4 tsp white pepper. Set aside dry batter.",
                    "Pat 6-8 oz chicken breasts dry with paper towels.",
                    "Dip chicken into wet batter, coating completely, then dredge in dry batter, shaking off excess.",
                    "Heat 2 cups beef tallow or lard to 350°F in a heavy-bottomed pot or Dutch oven.",
                    "Carefully place breaded chicken into hot fat and fry for 8-10 minutes until golden brown and internal temperature reaches 165°F.",
                    "Remove chicken and drain on paper towels."
                  ]
                },
                {
                  "name": "Cognac Cream Sauce",
                  "steps": [
                    "Heat 2 tbsp unsalted butter in a saucepan over medium heat.",
                    "Add 2 minced shallots, cook 2 minutes until softened.",
                    "Pour in 3 tbsp cognac, simmer 2 minutes to reduce and cook off alcohol.",
                    "Add 1/4 cup beef broth and 2 fresh thyme sprigs, simmer 2 minutes.",
                    "Remove thyme sprigs.",
                    "Slowly whisk in 3/4 cup heavy cream.",
                    "Bring to gentle simmer, cook 2 minutes until slightly thickened.",
                    "Whisk in 1/2 tsp Dijon mustard.",
                    "Season with 1/4 tsp salt and 1/8 tsp white pepper.",
                    "Keep warm and reserve 2 tbsp for slaw dressing."
                  ]
                },
                {
                  "name": "Crispy Fried Shallots",
                  "steps": [
                    "Thinly slice 1-2 shallots into rings.",
                    "Heat 1/2 cup beef tallow or lard to 325°F in a small skillet.",
                    "Fry shallot rings for 2-3 minutes until golden, watching carefully to avoid burning.",
                    "Drain on paper towels.",
                    "Reserve 2 tbsp for the slaw."
                  ]
                },
                {
                  "name": "Shallot Herb Gruyère Slaw",
                  "steps": [
                    "Whisk together 2 tbsp cognac cream sauce, 1 tbsp mayonnaise, 1/2 tsp Dijon mustard, 1 tbsp fresh lemon juice, and a pinch of salt for the dressing.",
                    "In a bowl, toss 1/2 cup shredded red cabbage, 1/4 cup fresh arugula, 2 tbsp crispy fried shallots, 1 tbsp shaved gruyère, 1/2 tsp fresh thyme leaves, and 1 tbsp fresh parsley (chopped).",
                    "Pour dressing over and toss to coat.",
                    "Refrigerate until ready to serve."
                  ]
                },
                {
                  "name": "Cognac Shallot Bacon Jam",
                  "steps": [
                    "Cook 4 slices diced thick-cut bacon in a skillet over medium heat until crispy, about 6-7 minutes.",
                    "Drain most fat, leaving about 1 tbsp in the pan.",
                    "Add 2 minced shallots, cook 2-3 minutes until deeply caramelized.",
                    "Add 1/2 tsp fresh thyme leaves, cook 30 seconds.",
                    "Deglaze with 2 tbsp cognac, simmer 1 minute.",
                    "Add 1/2 tsp Dijon mustard, 1 tbsp brown sugar, 1 tbsp apple cider vinegar, and 2 tbsp water.",
                    "Simmer on low for 15-18 minutes until thick and jammy.",
                    "Let cool slightly and roughly chop to a spreadable consistency."
                  ]
                },
                {
                  "name": "Dijon Thyme Goat Cheese Spread",
                  "steps": [
                    "Mix 1 tbsp softened cream cheese and 1 tbsp softened goat cheese together until smooth.",
                    "Stir in 1/2 tsp Dijon mustard, 1/2 tsp fresh thyme leaves (minced), 1 mashed roasted garlic clove, a pinch of cracked black pepper, and a pinch of salt.",
                    "Mix until evenly combined."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter the potato bun and toast in a skillet until golden on both sides.",
                    "Spread Dijon Thyme Goat Cheese Spread on the bottom bun.",
                    "Add a layer of Cognac Shallot Bacon Jam on top of the spread.",
                    "Place the fried chicken on the bottom bun.",
                    "Top with 2 slices of aged gruyère, allowing it to melt from the heat.",
                    "Spoon Cognac Cream Sauce generously over the melted gruyère.",
                    "Top with Shallot Herb Gruyère Slaw, extra crispy fried shallots, and fresh thyme.",
                    "Place top bun and serve immediately."
                  ]
                }
              ],
              "id": "recipe-57",
