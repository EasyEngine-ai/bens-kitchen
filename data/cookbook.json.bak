              "directionGroups": [
                {
                  "name": "Chicken & Batter",
                  "steps": [
                    "Pat chicken breast dry with paper towels.",
                    "Whisk together buttermilk, egg, and fresh lime juice in a shallow bowl.",
                    "In another shallow bowl, combine flour, potato starch, chicken bouillon powder, garlic powder, salt, and white pepper.",
                    "Dip chicken into wet batter, coat thoroughly, then dredge in dry batter, pressing gently to adhere. Let rest on a plate for 5 minutes.",
                    "Heat beef tallow or lard to 350°F in a heavy-bottomed pot or deep skillet, using a thermometer for accuracy.",
                    "Carefully place battered chicken into hot oil and fry for 6-7 minutes until golden brown and internal temperature reaches 165°F.",
                    "Drain on paper towels."
                  ]
                },
                {
                  "name": "Peruvian Green Sauce",
                  "steps": [
                    "Place fresh cilantro, fresh mint, fresh parsley, pepitas, minced garlic, fresh lime juice, and salt in a food processor.",
                    "Pulse until finely chopped and combined.",
                    "Add sour cream and pulse until the sauce reaches a smooth, pourable consistency.",
                    "Taste and adjust seasonings as needed. The sauce should be vibrant green and herbaceous."
                  ]
                },
                {
                  "name": "Pickled Red Onion",
                  "steps": [
                    "Thinly slice red onion and place in a small bowl.",
                    "Pour red wine vinegar, fresh lime juice, and salt over the onions.",
                    "Toss to combine.",
                    "Let sit at room temperature for 15 minutes before serving."
                  ]
                },
                {
                  "name": "Green Cilantro Goat Cheese Spread",
                  "steps": [
                    "In a food processor, combine fresh cilantro, minced roasted green chiles, minced garlic, fresh lime juice, and salt.",
                    "Pulse until finely chopped.",
                    "In a small bowl, combine softened cream cheese and fresh goat cheese. Mix until smooth.",
                    "Fold the cilantro-chile mixture into the cheese until well combined."
                  ]
                },
                {
                  "name": "Candied Jalapeños",
                  "steps": [
                    "In a small saucepan, combine sugar, apple cider vinegar, and water over medium heat.",
                    "Stir until the sugar dissolves and the mixture comes to a simmer.",
                    "Add sliced jalapeño rings and cook for 5-7 minutes, stirring occasionally.",
                    "The liquid should become thick and syrupy and the jalapeños should be glossy and slightly translucent.",
                    "Remove from heat and let cool."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter and toast the bun lightly until golden, about 1-2 minutes per side.",
                    "Spread the green cilantro goat cheese spread on the bottom bun.",
                    "Place the green sauce-coated chicken on top.",
                    "Top with pickled red onions, candied jalapeños, crumbled queso fresco, and sliced avocado.",
                    "Cap with the toasted top bun.",
                    "Serve immediately while the chicken is hot."
                  ]
                }
              ],
              "id": "recipe-45",
              "number": 45,
              "title": "Peruvian Green Sauce Chicken Sandwich",
              "slug": "peruvian-green-sauce-chicken-sandwich",
              "chapterId": "chapter-6"
            },
            {
              "description": "A sophisticated smoky and creamy sandwich combining the depth of charred chipotle with the richness of Mexican crema and fresh herbs. Crispy fried chicken is topped with a smooth chipotle adobo crema sauce that perfectly balances heat with cool creaminess. A smoky chipotle cabbage slaw featuring red cabbage adds textural crunch, while a smoky bacon goat cheese spread on the bottom bun brings savory depth. Finished with pickled jalapeños, crumbled cotija, and avocado for a refined Latin sandwich experience.",
              "aboutSections": [
                {
                  "name": "Chicken & Batter",
                  "description": "A subtly spiced fried crust with smoked paprika and chipotle powder for a warm, smoky foundation."
                },
                {
                  "name": "Chipotle Adobo Crema Sauce",
                  "description": "A silky, complex sauce of Mexican crema infused with chipotle peppers in adobo, lime, and cilantro."
                },
                {
                  "name": "Smoky Chipotle Cabbage Slaw",
                  "description": "A crunchy slaw of shredded red cabbage dressed in a chipotle-adobo vinaigrette with lime brightness."
                },
                {
                  "name": "Smoky Bacon Goat Cheese Spread",
                  "description": "A savory spread combining crispy bacon with goat cheese, cream cheese, and smoked paprika."
                },
                {
                  "name": "Chipotle Adobo Crema",
                  "description": "A creamy, spiced sauce that coats the chicken with rich, authentic flavor."
                },
                {
                  "name": "Smoky Chipotle Adobo Slaw",
                  "description": "A creamy, spiced sauce that coats the chicken with rich, authentic flavor."
                },
                {
