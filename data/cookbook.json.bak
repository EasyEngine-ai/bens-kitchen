              "directionGroups": [
                {
                  "name": "Chicken & Batter",
                  "steps": [
                    "Combine 1/2 cup buttermilk and 1 egg in a bowl and whisk until smooth. Set aside wet batter.",
                    "In another bowl, whisk together 1/4 cup all-purpose flour, 1/4 cup potato starch, 1 tsp chicken bouillon powder, 1/4 tsp ground cinnamon, 1/2 tsp salt, and 1/4 tsp black pepper. Set aside dry batter.",
                    "Pat 6-8 oz chicken breasts dry with paper towels.",
                    "Dip chicken into wet batter, coating completely, then dredge in dry batter, shaking off excess.",
                    "Heat 2 cups beef tallow or lard to 350°F in a heavy-bottomed pot or Dutch oven.",
                    "Carefully place breaded chicken into hot fat and fry for 8-10 minutes until golden brown and internal temperature reaches 165°F.",
                    "Remove chicken and drain on paper towels."
                  ]
                },
                {
                  "name": "Spiced Apricot Glaze",
                  "steps": [
                    "Combine 3/4 cup chopped dried apricots and 1/2 cup water in a small saucepan.",
                    "Bring to a simmer over medium heat, cook 5 minutes until apricots soften.",
                    "Add 1 tbsp brown sugar, 1 tbsp fresh lemon juice, 1/2 tbsp aged balsamic vinegar, 1/4 tsp ground cinnamon, and 1/4 tsp fresh ginger (grated).",
                    "Simmer 3-4 minutes until thick and glaze-like.",
                    "Season with a pinch of salt.",
                    "Remove from heat. Reserve 2 tbsp for slaw and 1 tsp for goat cheese spread."
                  ]
                },
                {
                  "name": "Toasted Walnuts",
                  "steps": [
                    "Spread 1/3 cup walnut pieces on a baking sheet.",
                    "Toast at 325°F for 5-7 minutes until fragrant.",
                    "Set aside. Reserve 1 tbsp for the slaw."
                  ]
                },
                {
                  "name": "Spiced Apricot Walnut Arugula Slaw",
                  "steps": [
                    "Whisk together 2 tbsp apricot glaze, 1 tbsp extra virgin olive oil, 1 tsp fresh lemon juice, 1/2 tsp honey, and a pinch of salt for the dressing.",
                    "In a bowl, combine 1/2 cup fresh arugula, 2 tbsp thinly sliced dried apricots, 1 tbsp toasted walnuts (chopped), 1 tbsp dried cranberries, 1 tbsp shaved Brie, and 1/2 tsp fresh thyme leaves.",
                    "Pour dressing over and toss gently to coat.",
                    "Refrigerate until ready to serve."
                  ]
                },
                {
                  "name": "Spiced Apricot Bacon Jam",
                  "steps": [
                    "Cook 4 slices diced thick-cut bacon in a skillet over medium heat until crispy, about 6-7 minutes.",
                    "Drain most fat, leaving about 1 tbsp.",
                    "Add 1 minced shallot, cook 2 minutes.",
                    "Add 1/4 cup finely diced dried apricots, cook 2-3 minutes until they soften and caramelize.",
                    "Add 1/4 tsp ground cinnamon, 1/4 tsp fresh ginger (grated), 1 tbsp brown sugar, 1 tbsp apple cider vinegar, and 2 tbsp water.",
                    "Simmer on low for 15-18 minutes until thick and jammy.",
                    "Let cool and roughly chop to spreadable consistency."
                  ]
                },
                {
                  "name": "Spiced Apricot Brie Goat Cheese Spread",
                  "steps": [
                    "Mix 1 tbsp softened cream cheese, 1 tbsp softened goat cheese, and 1 tbsp softened Brie (rind removed) until smooth.",
                    "Stir in 1 tsp spiced apricot glaze and a pinch of ground cinnamon and salt.",
                    "Mix until evenly combined."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter the potato bun and toast in a skillet until golden on both sides.",
                    "Spread Spiced Apricot Brie Goat Cheese Spread on the bottom bun.",
                    "Add a layer of Spiced Apricot Bacon Jam on top of the spread.",
                    "Place the fried chicken on the bottom bun.",
                    "Top with Brie slices, allowing them to get creamy from the heat.",
                    "Spoon Spiced Apricot Glaze generously over the Brie and chicken.",
                    "Top with Spiced Apricot Walnut Arugula Slaw, extra toasted walnuts, and fresh thyme.",
                    "Place top bun and serve immediately."
                  ]
                }
              ],
              "id": "recipe-63",
              "number": 63,
              "title": "Spiced Apricot Walnut Chicken Sandwich",
              "slug": "spiced-apricot-walnut-chicken-sandwich",
              "chapterId": "chapter-8"
            },
            {
              "description": "Southern comfort meets sweet sophistication — juicy peaches caramelized in nutty brown butter and flambéed with bourbon create a rich, smoky-sweet glaze over crispy fried chicken. Sharp white cheddar adds savory edge, candied pecans bring crunchy sweetness, and fried onion straws pile on texture.",
