                }
              ],
              "directions": [
                "Preheat oven to 400°F.",
                "Cut the top off 1 whole garlic bulb.",
                "Drizzle with 1/2 tbsp olive oil, season with a pinch each of salt and black pepper.",
                "Place 2 fresh thyme sprigs on top.",
                "Wrap in foil and roast 30-35 minutes until cloves are soft and golden.",
                "Let cool, then squeeze out all cloves.",
                "Reserve for use across sauce, jam, and spread."
