              "directionGroups": [
                {
                  "name": "Chicken & Batter",
                  "steps": [
                    "Combine 1/2 cup buttermilk and 1 egg in a bowl and whisk until smooth. Set aside wet batter.",
                    "In another bowl, whisk together 1/4 cup all-purpose flour, 1/4 cup potato starch, 1 tsp chicken bouillon powder, 1/2 tsp cracked black pepper, 1/4 tsp dried rosemary, and 1/2 tsp salt. Set aside dry batter.",
                    "Pat 6-8 oz chicken breasts dry with paper towels.",
                    "Dip chicken into wet batter, coating completely, then dredge in dry batter, shaking off excess.",
                    "Heat 2 cups beef tallow or lard to 350°F in a heavy-bottomed pot or Dutch oven.",
                    "Carefully place breaded chicken into hot fat and fry for 8-10 minutes until golden brown and internal temperature reaches 165°F.",
                    "Remove chicken and drain on paper towels."
                  ]
                },
                {
                  "name": "Strawberry Balsamic Sauce",
                  "steps": [
                    "Heat 1 tbsp unsalted butter in a saucepan over medium heat.",
                    "Add 1 minced shallot, cook 2 minutes until softened.",
                    "Add 1.5 cups fresh strawberries (halved) and cook 4-5 minutes until they soften and break down.",
                    "Pour in 3 tbsp balsamic vinegar and 1 tbsp brown sugar, stir to combine.",
                    "Simmer 5-6 minutes until the sauce thickens to glossy consistency.",
                    "Stir in 1/2 tbsp fresh lemon juice, 1/4 tsp cracked black pepper, 1/4 tsp fresh rosemary (minced), 1/2 tsp fresh basil (minced), and a pinch of salt.",
                    "Remove from heat. Sauce should be thick enough to coat the chicken without running."
                  ]
                },
                {
                  "name": "Balsamic Glaze",
                  "steps": [
                    "Pour 1/2 cup balsamic vinegar into a small saucepan over medium heat.",
                    "Stir in 1 tsp honey.",
                    "Bring to a simmer and cook 8-10 minutes until reduced by half and thick enough to coat the back of a spoon.",
                    "Let cool — it will thicken more as it cools."
                  ]
                },
                {
                  "name": "Crispy Prosciutto",
                  "steps": [
                    "Lay 2 oz (about 3-4 slices) sliced prosciutto on a baking sheet.",
                    "Bake at 400°F for 5-7 minutes until crispy.",
                    "Set aside and reserve 1 tbsp crumbled bits for the slaw."
                  ]
                },
                {
                  "name": "Strawberry Balsamic Arugula Slaw",
                  "steps": [
                    "In a bowl, toss 1/2 cup fresh arugula, 3-4 thinly sliced fresh strawberries, 2 tbsp shaved Parmesan, 1 tbsp crispy prosciutto bits, 1 tsp fresh basil (thinly sliced), and a pinch of cracked black pepper.",
                    "Drizzle 1 tbsp balsamic glaze and 1 tbsp extra virgin olive oil over the top.",
                    "Finish with a pinch each of flaky sea salt and cracked pepper.",
                    "Toss gently and refrigerate until ready to serve."
                  ]
                },
                {
                  "name": "Balsamic Strawberry Bacon Jam",
                  "steps": [
                    "Cook 4 slices diced thick-cut bacon in a skillet over medium heat until crispy, about 6-7 minutes.",
                    "Drain most fat, leaving about 1 tbsp.",
                    "Add 1 minced shallot, cook 2 minutes.",
                    "Add 1/4 cup diced fresh strawberries, cook 2-3 minutes until they break down.",
                    "Add 1.5 tbsp balsamic vinegar, 1/4 tsp fresh rosemary (minced), 1/4 tsp cracked black pepper, 1 tbsp brown sugar, and 2 tbsp water.",
                    "Simmer on low for 15-18 minutes until thick and jammy.",
                    "Let cool and roughly chop to spreadable consistency."
                  ]
                },
                {
                  "name": "Black Pepper Mascarpone Goat Cheese Spread",
                  "steps": [
                    "Mix 1 tbsp mascarpone and 1 tbsp softened goat cheese until smooth.",
                    "Stir in 1/2 tsp cracked black pepper, 1/4 tsp fresh rosemary (finely minced), 1/4 tsp lemon zest, 1 mashed roasted garlic clove, and a pinch of salt.",
                    "Mix until evenly combined."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter the potato bun and toast in a skillet until golden on both sides.",
                    "Spread Black Pepper Mascarpone Goat Cheese Spread on the bottom bun.",
                    "Add a layer of Balsamic Strawberry Bacon Jam on top of the spread.",
                    "Place the fried chicken on the bottom bun.",
                    "Layer crispy prosciutto over the chicken.",
                    "Spoon Strawberry Balsamic Sauce generously over the prosciutto and chicken.",
                    "Drizzle Balsamic Glaze on top.",
                    "Top with Strawberry Balsamic Arugula Slaw, extra shaved Parmesan, fresh basil, and a final crack of black pepper.",
                    "Place top bun and serve immediately."
                  ]
                }
              ],
