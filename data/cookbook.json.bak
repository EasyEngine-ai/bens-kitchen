              "directionGroups": [
                {
                  "name": "Tomato Basil Marinara",
                  "steps": [
                    "Heat olive oil in a small saucepan over medium heat.",
                    "Add minced garlic and cook for 1 minute until fragrant.",
                    "Add crushed tomatoes, dried oregano, brown sugar, salt, black pepper, and red pepper flakes.",
                    "Simmer for 8-10 minutes, stirring occasionally, until slightly thickened.",
                    "Remove from heat and stir in fresh basil chiffonade.",
                    "Keep warm until ready to use."
                  ]
                },
                {
                  "name": "Pepperoni Cherry Tomato Jam",
                  "steps": [
                    "In a small skillet over medium heat, cook diced pepperoni for 2-3 minutes until it renders fat and begins to crisp.",
                    "Add finely diced onion and minced garlic, cooking for 2 minutes until softened.",
                    "Add quartered cherry tomatoes, chopped sun-dried tomatoes, brown sugar, Italian seasoning, and red pepper flakes.",
                    "Reduce heat to medium-low and simmer for 10-12 minutes, stirring occasionally, until tomatoes break down and mixture becomes thick and jammy.",
                    "Season with salt. Remove from heat and cool slightly."
                  ]
                },
                {
                  "name": "Caprese Feta Goat Cheese Spread",
                  "steps": [
                    "In a small bowl, combine softened cream cheese and fresh goat cheese, mixing until smooth.",
                    "Fold in crumbled feta cheese, diced roasted red peppers, and mashed roasted garlic cloves.",
                    "Stir in finely minced sun-dried tomato, finely minced fresh basil, Italian seasoning, and red wine vinegar.",
                    "Fold in grated Parmesan cheese.",
                    "Season with salt and black pepper. Set aside."
                  ]
                },
                {
                  "name": "Italian Arugula Slaw",
                  "steps": [
                    "In a large bowl, combine baby arugula, shredded red cabbage, halved cherry tomatoes, sliced red onions, and crumbled feta cheese.",
                    "Add sliced pepperoncini peppers, sliced cherry peppers, chopped salami, and crushed croutons.",
                    "In a small bowl, whisk together mayonnaise, red wine vinegar, extra virgin olive oil, and Italian seasoning.",
                    "Pour dressing over vegetables and toss to coat evenly.",
                    "Season with salt and black pepper. Refrigerate until ready to serve."
                  ]
                },
                {
                  "name": "Chicken & Batter",
                  "steps": [
                    "Pound the chicken cutlet to an even 3/4-inch thickness.",
                    "In a shallow bowl, whisk together buttermilk and egg.",
                    "In another shallow bowl, combine all-purpose flour, potato starch, chicken bouillon powder, dried basil, garlic powder, salt, and black pepper.",
                    "Submerge chicken in wet batter for at least 15 minutes (or up to 4 hours refrigerated).",
                    "Remove from wet batter and dredge thoroughly in dry batter, pressing gently to adhere. For extra crunch, dip back in wet batter and dredge again.",
                    "Heat beef tallow or lard to 350°F in a deep pot or cast iron skillet.",
                    "Carefully place breaded chicken into hot oil and fry for 6-7 minutes until golden brown and internal temperature reaches 165°F.",
                    "Remove with slotted spoon and drain on a wire rack."
                  ]
                },
                {
                  "name": "Assembly",
                  "steps": [
                    "Butter both halves of the sub roll and toast on a griddle or skillet for 1-2 minutes until golden.",
                    "Spread Caprese Feta Goat Cheese Spread on the bottom sub roll.",
                    "Spoon a generous layer of Pepperoni Cherry Tomato Jam over the spread.",
                    "Place the fried chicken on top of the jam.",
                    "Spoon Tomato Basil Marinara generously over the chicken.",
                    "Layer fresh mozzarella slices over the marinara.",
                    "Pile Italian Arugula Slaw on top.",
                    "Tuck in fresh basil leaves.",
                    "Place top bun and serve immediately while hot."
                  ]
                }
              ],
              "id": "recipe-34",
              "number": 34,
              "title": "Tomato Basil Mozzarella Chicken Sub - Warm Caprese",
              "slug": "tomato-basil-mozzarella-chicken-sub-warm-caprese",
              "chapterId": "chapter-5"
            },
            {
              "description": "This rich and luxurious sub features a silky Tuscan cream sauce infused with sun-dried tomatoes, spinach, garlic, and a whisper of nutmeg smothered over crispy fried chicken. Fresh arugula, cherry tomatoes, roasted red peppers, mozzarella, and pickled red onions pile on top, while a pepperoni cherry tomato jam and sun-dried tomato basil cream cheese spread on the bottom sub roll add smoky depth and herby richness.",
              "aboutSections": [
                {
                  "name": "Chicken & Batter",
                  "description": "A perfectly golden fried chicken cutlet with a delicate crust seasoned with Italian herbs and garlic."
                },
                {
                  "name": "Tuscan Cream Sauce",
                  "description": "A luxurious, herbaceous cream sauce made with sun-dried tomatoes, fresh spinach, butter, heavy cream, Parmesan, and a whisper of nutmeg."
                },
                {
                  "name": "Italian Arugula Slaw",
                  "description": "A fresh, peppery slaw of baby arugula, shredded red cabbage, cherry tomatoes, feta cheese, and salami, dressed with a light red wine vinegar vinaigrette."
                },
                {
                  "name": "Pepperoni Cherry Tomato Jam",
                  "description": "A sweet and savory jam made from pepperoni, fresh and sun-dried cherry tomatoes, caramelized onions, and garlic, reduced to a thick, spreadable consistency."
                },
                {
                  "name": "Sun-Dried Tomato Basil Goat Cheese Spread",
                  "description": "A vibrant, herbaceous spread combining goat cheese and cream cheese with sun-dried tomatoes, fresh basil, roasted red peppers, roasted garlic, and crumbled feta."
                }
              ],
