            {
              "usedIn": [
                "Tikka Masala Chicken Sandwich"
              ],
              "description": "A smooth, rich tomato-based sauce enriched with cream and built on a foundation of toasted cumin seeds, ginger, and garlic. Warm spices like garam masala, turmeric, and crushed fenugreek leaves add depth and aromatics, making this sauce aromatic, creamy, and perfectly balanced between savory and slightly sweet.",
              "ingredients": [
                {
                  "item": "unsalted butter",
                  "amount": "2 tablespoons"
                },
                {
                  "item": "yellow onion, diced",
                  "amount": "1/3 cup"
                },
                {
                  "item": "ginger, minced",
                  "amount": "1 tablespoon"
                },
                {
                  "item": "garlic, minced",
                  "amount": "3 cloves"
                },
                {
                  "item": "cumin seeds",
                  "amount": "1/4 teaspoon"
                },
                {
                  "item": "turmeric powder",
                  "amount": "1/2 teaspoon"
                },
                {
                  "item": "cumin powder",
                  "amount": "1/2 teaspoon"
                },
                {
                  "item": "coriander powder",
                  "amount": "1/2 teaspoon"
                },
                {
                  "item": "garam masala",
                  "amount": "1 teaspoon"
                },
                {
                  "item": "canned crushed tomatoes",
                  "amount": "3/4 cup"
                },
                {
                  "item": "heavy cream",
                  "amount": "1/4 cup"
                },
                {
                  "item": "honey",
                  "amount": "1 teaspoon"
                },
                {
                  "item": "dried fenugreek leaves (kasuri methi), crushed",
                  "amount": "1/2 teaspoon"
                },
                {
                  "item": "salt",
                  "amount": "to taste"
                },
                {
                  "item": "black pepper",
                  "amount": "to taste"
                }
              ],
              "directions": [
                "Heat 2 tablespoons butter in a small saucepan over medium heat.",
                "Add 1/4 teaspoon cumin seeds and toast for 30 seconds until fragrant.",
                "Add 1/3 cup diced yellow onion and cook for 6-7 minutes, stirring occasionally, until the onion is golden and softened.",
                "Add 1 tablespoon minced ginger and 3 minced garlic cloves; cook for 1 minute until fragrant.",
                "Add 1/2 teaspoon turmeric, 1/2 teaspoon cumin powder, 1/2 teaspoon coriander powder, and 1 teaspoon garam masala; stir constantly for 1 minute.",
                "Add 3/4 cup crushed tomatoes and stir well; simmer for 8-10 minutes over medium heat, stirring occasionally.",
                "Remove from heat and carefully pour the mixture into a blender. Blend on high until completely smooth, about 1-2 minutes. (Alternatively, use an immersion blender in the saucepan.)",
                "Pour the blended sauce back into the saucepan and return to medium heat.",
                "Stir in 1/4 cup heavy cream, 1 teaspoon honey, and 1/2 teaspoon crushed dried fenugreek leaves.",
                "Simmer for 2-3 minutes, stirring occasionally. Season with salt and black pepper to taste. Keep warm on low heat."
              ],
              "id": "comp-tikka-masala-sauce",
              "title": "Tikka Masala Sauce",
              "slug": "tikka-masala-sauce",
              "categoryId": "sauces-glazes-aiolis"
            },
            {
              "usedIn": [
                "Korma Chicken Sandwich"
              ],
              "description": "A luxurious, creamy sauce built on a foundation of caramelized onions and warm spices like cinnamon and coriander. Yogurt and coconut cream create richness while ground almonds add body and subtle nuttiness. This sauce is aromatic, elegant, and perfectly balanced between savory warmth and mild sweetness.",
              "ingredients": [
                {
                  "item": "ghee or unsalted butter",
                  "amount": "2 tablespoons"
                },
                {
                  "item": "yellow onion, sliced thin",
                  "amount": "1/2"
                },
                {
                  "item": "ginger, minced",
                  "amount": "1 teaspoon"
                },
                {
                  "item": "garlic, minced",
                  "amount": "2 cloves"
                },
                {
                  "item": "cinnamon stick, broken",
                  "amount": "1 piece"
                },
                {
                  "item": "coriander powder",
                  "amount": "1 teaspoon"
                },
                {
                  "item": "turmeric powder",
                  "amount": "1/4 teaspoon"
                },
                {
                  "item": "plain yogurt",
                  "amount": "2 tablespoons"
                },
                {
                  "item": "coconut cream",
                  "amount": "3 tablespoons"
                },
                {
                  "item": "ground almonds",
                  "amount": "2 tablespoons"
                },
                {
                  "item": "chicken stock",
                  "amount": "2 tablespoons"
                },
                {
                  "item": "salt",
                  "amount": "to taste"
                },
                {
                  "item": "white pepper",
                  "amount": "to taste"
                }
              ],
              "directions": [
                "Heat 2 tablespoons ghee or butter in a small saucepan over medium heat.",
                "Add 1/2 thinly sliced yellow onion and cook for 8-9 minutes, stirring frequently, until golden brown and caramelized. This step is important for korma authenticity.",
                "Add 1 teaspoon minced ginger and 2 minced garlic cloves; cook for 1 minute until fragrant.",
                "Add 1 broken cinnamon stick piece; cook for 30 seconds.",
                "Stir in 1 teaspoon coriander powder and 1/4 teaspoon turmeric powder; cook for 30 seconds.",
                "Remove from heat and let cool for 1 minute. Whisk in 2 tablespoons plain yogurt slowly, stirring constantly to avoid curdling.",
                "Return to medium-low heat and gently warm through for 1-2 minutes. Do not boil.",
                "Stir in 3 tablespoons coconut cream and 2 tablespoons ground almonds, whisking until smooth.",
                "Add 2 tablespoons chicken stock and simmer gently for 5-7 minutes, stirring occasionally, until slightly thickened.",
                "Season with salt and white pepper to taste. Remove the cinnamon stick piece before serving. Keep warm on low heat."
              ],
              "id": "comp-korma-sauce",
              "title": "Korma Sauce",
              "slug": "korma-sauce",
              "categoryId": "sauces-glazes-aiolis"
            },
            {
              "usedIn": [
                "Coconut Curry Chicken Sandwich"
              ],
              "description": "A silky, aromatic sauce that bridges Thai and Indian flavors with rich coconut milk, warm curry powder, turmeric, and cumin, all built on a fragrant base of ginger and garlic. The addition of fresh lime juice and a touch of fish sauce brings brightness and umami depth. This sauce is creamy, complex, and perfectly balanced between savory and subtly sweet.",
              "ingredients": [
                {
                  "item": "oil",
                  "amount": "1 tablespoon"
                },
                {
                  "item": "yellow onion, minced",
                  "amount": "1/2"
                },
                {
                  "item": "ginger, minced",
                  "amount": "1 teaspoon"
                },
                {
                  "item": "garlic, minced",
                  "amount": "2 cloves"
                },
                {
                  "item": "curry powder",
                  "amount": "2 teaspoons"
                },
                {
                  "item": "turmeric powder",
                  "amount": "1/4 teaspoon"
                },
                {
                  "item": "cumin powder",
                  "amount": "1 teaspoon"
                },
                {
                  "item": "coconut milk",
                  "amount": "1/2 cup"
                },
                {
                  "item": "chicken stock",
                  "amount": "2 tablespoons"
                },
                {
                  "item": "lime juice, fresh",
                  "amount": "1 tablespoon"
                },
                {
                  "item": "fish sauce or soy sauce",
                  "amount": "1 teaspoon"
                },
                {
                  "item": "brown sugar",
                  "amount": "1 teaspoon"
                },
                {
                  "item": "salt",
                  "amount": "to taste"
                },
                {
                  "item": "black pepper",
                  "amount": "to taste"
                }
              ],
              "directions": [
                "Heat 1 tablespoon oil in a small saucepan over medium heat.",
                "Add 1/2 minced yellow onion and cook for 4-5 minutes, stirring occasionally, until softened and beginning to turn translucent.",
                "Add 1 teaspoon minced ginger and 2 minced garlic cloves; cook for 1 minute until fragrant.",
                "Stir in 2 teaspoons curry powder, 1/4 teaspoon turmeric powder, and 1 teaspoon cumin powder; cook for 1 minute, stirring constantly.",
                "Add 1/2 cup coconut milk and 2 tablespoons chicken stock; stir well.",
                "Reduce heat to medium-low and simmer for 8-10 minutes, stirring occasionally, until slightly thickened.",
                "Remove from heat and stir in 1 tablespoon fresh lime juice, 1 teaspoon fish sauce or soy sauce, and 1 teaspoon brown sugar.",
                "Season with salt and black pepper to taste. Keep warm over low heat."
              ],
              "id": "comp-coconut-curry-sauce",
              "title": "Coconut Curry Sauce",
              "slug": "coconut-curry-sauce",
              "categoryId": "sauces-glazes-aiolis"
            },
